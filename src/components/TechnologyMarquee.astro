---
interface Props {
  class?: string;
  pauseOnHover?: boolean;
}

const { class: className, pauseOnHover = true } = Astro.props;

const technologies = [
  { name: "AWS", src: "/images/technologies/aws.svg" },
  { name: "Docker", src: "/images/technologies/docker.svg" },
  { name: "Flutter", src: "/images/technologies/flutter.svg" },
  { name: "JavaScript", src: "/images/technologies/javascript.svg" },
  { name: "Laravel", src: "/images/technologies/laravel.svg" },
  { name: "MongoDB", src: "/images/technologies/mongodb.svg" },
  { name: "MySQL", src: "/images/technologies/mysql.svg" },
  { name: "Node.js", src: "/images/technologies/nodejs.svg" },
  { name: "Odoo", src: "/images/technologies/odoo.svg" },
  { name: "PHP", src: "/images/technologies/php.svg" },
  { name: "PostgreSQL", src: "/images/technologies/postgresql.svg" },
  { name: "Python", src: "/images/technologies/python.svg" },
  { name: "React", src: "/images/technologies/react.svg" },
] as const;
---

<div class:list={["tech-marquee", className]}>
  <div
    class:list={[
      "tech-marquee-track",
      pauseOnHover && "tech-marquee-track--pausable",
    ]}
  >
    <ul class="tech-marquee-set">
      {
        technologies.map((tech) => (
          <li>
            <img
              src={tech.src}
              alt={tech.name}
              height="48"
              loading="lazy"
              decoding="async"
            />
          </li>
        ))
      }
    </ul>
    <ul class="tech-marquee-set tech-marquee-clone" aria-hidden="true">
      {
        technologies.map((tech) => (
          <li>
            <img
              src={tech.src}
              alt=""
              height="48"
              loading="lazy"
              decoding="async"
            />
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  @keyframes tech-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .tech-marquee {
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  .tech-marquee-track {
    display: flex;
    width: max-content;
    animation: tech-marquee 30s linear infinite;
  }

  :global([dir="rtl"]) .tech-marquee-track {
    animation-direction: reverse;
  }

  .tech-marquee-set {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tech-marquee-set li {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding-inline: 2rem;
  }

  .tech-marquee-set img {
    height: 2.5rem;
    width: auto;
    opacity: 0.5;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  @media (min-width: 768px) {
    .tech-marquee-set img {
      height: 3rem;
    }
  }

  .tech-marquee-set img:hover {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-marquee {
      mask-image: none;
    }

    .tech-marquee-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
    }

    .tech-marquee-clone {
      display: none;
    }

    .tech-marquee-set img:hover {
      transform: none;
    }
  }
</style>
