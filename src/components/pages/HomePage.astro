---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import LogoPlaceholder from "../../components/LogoPlaceholder.astro";
import TechnologyMarquee from "../../components/TechnologyMarquee.astro";
import {
  getServices,
  getBlogPosts,
  serviceColors,
  serviceLabel,
} from "../../lib/collections";
import { buildWebPage, siteUrl } from "../../lib/jsonld";
import { business } from "../../data/business";
import { clients, clientSectors } from "../../data/clients";
import {
  blogImages,
  goalImages,
  heroImage,
  localizedEntryId,
  serviceImages,
} from "../../data/editorial-images";

const servicesEntries = await getServices();
const latestBlogPosts = (await getBlogPosts()).slice(0, 3);

const formatBlogDate = (d: Date) =>
  d.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

const testimonials = [
  {
    quote:
      "We needed Odoo live without freezing day-to-day operations. ENET planned the cutover, trained our staff, and stayed close after go-live — the kind of partner you want when ERP touches every department.",
    name: "Ahmad R.",
    title: "Group IT Manager",
    org: "Multi-branch retail",
  },
  {
    quote:
      "Our storefront was fast in the office and slow for customers on mobile. They profiled the stack, fixed the real bottlenecks, and gave us a checklist so we do not slide backwards after launch.",
    name: "Layla M.",
    title: "Head of E-commerce",
    org: "Fashion & beauty brand",
  },
  {
    quote:
      "Clear communication, realistic timelines, and engineers who understand both product and infrastructure. They have shipped multiple releases for us and remain our first call for complex builds.",
    name: "Faisal T.",
    title: "Managing Director",
    org: "Industrial supplies",
  },
];

const stats = [
  { number: "10+", label: "Years helping businesses grow" },
  { number: "150+", label: "Projects delivered" },
  { number: "50+", label: "Clients served worldwide" },
  { number: "24/7", label: "Support after go-live" },
];

// Plain-language outcomes per service hub. Copy stays truthful to existing
// service content — no invented metrics, just customer benefits.
const serviceOutcomes: Record<string, { promise: string; points: string[] }> = {
  "odoo-erp": {
    promise: "Operations in one place, without the spreadsheets.",
    points: [
      "Inventory, sales, and finance connected",
      "Processes your team will actually follow",
      "Training and support after go-live",
    ],
  },
  "web-development": {
    promise: "A website that brings enquiries, not just visits.",
    points: [
      "Clear messaging for first-time visitors",
      "Fast on mobile, including multilingual storefronts",
      "Easy for your team to update",
    ],
  },
  "mobile-apps": {
    promise: "An app customers and teams enjoy using.",
    points: [
      "iOS and Android from one plan",
      "Connected to your store or operations",
      "Launch, updates, and care handled",
    ],
  },
  "agentic-automation": {
    promise: "Routine work that finishes without chasing it.",
    points: [
      "Agents connected to the tools you already use",
      "People in the loop on high-impact steps",
      "Logs, handovers, and support after go-live",
    ],
  },
};

const goals = [
  {
    title: "Operations feel chaotic",
    text: "Stock, sales, and finance live in different places and need constant manual work.",
    result: "One connected system your team trusts day to day.",
    href: "/services/odoo-erp",
    link: "Explore Odoo ERP",
    image: goalImages.operations,
  },
  {
    title: "You want to sell more online",
    text: "Your store is slow, hard to use on mobile, or missing the payments and languages your customers need.",
    result: "A fast, conversion-ready store built to turn visits into orders.",
    href: "/services/web-development/e-commerce",
    link: "Explore e-commerce",
    image: goalImages.ecommerce,
  },
  {
    title: "Your website doesn't build trust",
    text: "Visitors leave confused about what you offer or how to contact you.",
    result: "A clear, credible site that brings qualified enquiries.",
    href: "/services/web-development",
    link: "Explore websites",
    image: goalImages.website,
  },
  {
    title: "Work lives in disconnected tools",
    text: "Orders, inventory, and accounting need re-typing between systems.",
    result: "Connected workflows with less manual reconciliation.",
    href: "/services/odoo-erp/implementation",
    link: "Explore integrations",
    image: goalImages.integrations,
  },
];

const process = [
  {
    step: "01",
    title: "Listen and diagnose",
    text: "A focused conversation about your goals, current tools, and where work gets stuck.",
  },
  {
    step: "02",
    title: "Clear roadmap",
    text: "Scope, timeline, and options in plain language — so you can decide with confidence.",
  },
  {
    step: "03",
    title: "Build and launch",
    text: "Design, build, and testing with regular updates. We handle migration and training.",
  },
  {
    step: "04",
    title: "Support and improve",
    text: "We stay after go-live to fix issues, train your team, and add what you need next.",
  },
];

const consultationPoints = [
  "An honest view on whether you need new software at all",
  "Clear options with scope and timeline in plain language",
  "Next steps you can use even if we never work together",
];

const homeDescription =
  "ENET Systems helps businesses worldwide run operations smoothly, sell online, and launch websites and apps customers trust — Odoo ERP, e-commerce, web development, and mobile apps with ongoing support.";
---

<Layout
  title="ENET Systems LTD | Odoo ERP, E-commerce, Websites & Mobile Apps"
  description={homeDescription}
  jsonLd={buildWebPage({
    name: "ENET Systems LTD | Odoo ERP, E-commerce, Websites & Mobile Apps",
    description: homeDescription,
    url: siteUrl("/"),
  })}
>
  <Navbar />

  <!-- ── HERO — customer promise + consultation path ─────────────────── -->
  <section class="relative overflow-hidden bg-ink">
    <img
      src={heroImage.src}
      alt={heroImage.alt}
      class="absolute inset-0 h-full w-full object-cover object-center opacity-35"
      fetchpriority="high"
    />
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute top-1/4 -left-32 h-96 w-96 rounded-full bg-accent/20 blur-3xl"></div>
      <div class="absolute bottom-1/4 -right-32 h-96 w-96 rounded-full bg-fire/15 blur-3xl"></div>
      <div class="pointer-events-none absolute inset-0 halftone halftone-light opacity-15"></div>
      <div class="absolute inset-0 bg-linear-to-b from-transparent to-ink"></div>
    </div>

    <div class="container-custom relative z-10 py-16 md:py-24 lg:py-28">
      <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <div>
          <p class="mb-6 inline-flex items-center gap-2 border-2 border-accent/40 bg-accent/10 px-4 py-2 text-xs font-bold uppercase tracking-wider text-accent">
            <span class="h-2 w-2 animate-pulse rounded-full bg-accent" aria-hidden="true"></span>
            Web · E-commerce · Odoo ERP · Mobile apps
          </p>
          <h1 class="text-4xl font-bold leading-[1.08] text-white sm:text-5xl lg:text-6xl xl:text-7xl">
            Run smoother.<br />
            <span class="text-gradient-dual">Grow faster.</span>
          </h1>
          <p class="mb-8 mt-6 max-w-xl text-base leading-relaxed text-white/65 md:text-lg">
            We help companies across industries replace manual work, launch modern
            storefronts, and connect operations — from the first consultation to
            ongoing support.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a href="/contact" class="btn-fire px-8 py-3 text-base">
              Book a consultation
            </a>
            <a
              href="/#clients"
              class="border-2 border-white/20 px-8 py-3 text-base font-bold text-white/80 transition-colors duration-300 hover:border-white/40 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              See who we work with
            </a>
          </div>
          <p class="mt-6 text-sm font-medium text-white/45">
            Free initial consultation · Clear scope and timeline · Support after launch
          </p>
        </div>

        <aside class="border-2 border-white/10 bg-white p-6 md:p-8" aria-label="What you get from a consultation">
          <p class="text-xs font-bold uppercase tracking-widest text-accent">Start here</p>
          <h2 class="mt-2 text-2xl font-bold leading-snug text-ink md:text-3xl">
            What you get from a consultation
          </h2>
          <ul class="mt-6 space-y-4">
            {
              consultationPoints.map((point) => (
                <li class="flex items-start gap-3 text-[0.95rem] leading-relaxed text-ink/75">
                  <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>
          <div class="mt-8 flex flex-col gap-3 border-t-2 border-ink/5 pt-6 sm:flex-row">
            <a href="/contact" class="btn-primary flex-1 text-center text-sm">
              Book a consultation
            </a>
            <a
              href={business.telHref}
              class="flex-1 border-2 border-ink/15 px-4 py-3 text-center text-sm font-bold text-ink transition-colors hover:border-ink/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {business.phoneDisplay}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ── TRUST BAND — compact proof, not tech logos ──────────────────── -->
  <section class="border-b-2 border-ink/10 bg-white py-10" aria-label="Why businesses choose ENET">
    <div class="container-custom">
      <div class="grid grid-cols-2 gap-8 lg:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="text-center lg:text-left">
              <p class="text-4xl font-bold tracking-tight text-ink md:text-5xl">{stat.number}</p>
              <p class="mt-1 text-sm font-bold uppercase tracking-wider text-muted">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── GOALS — let visitors self-select ────────────────────────────── -->
  <section class="section-padding bg-secondary" aria-labelledby="goals-heading">
    <div class="container-custom">
      <div class="mb-12 max-w-2xl">
        <span class="badge badge-accent mb-4">Start from your goal</span>
        <h2 id="goals-heading" class="mt-4 text-4xl font-bold leading-[1.08] md:text-5xl">
          What do you need to improve?
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Pick the situation that sounds familiar. We will point you to the
          simplest solution that solves it — nothing more.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {
          goals.map((goal, i) => (
            <article
              class:list={[
                "group relative overflow-hidden border-2 border-ink/10 bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-xl",
                i % 2 === 1 ? "hover:border-fire/40" : "hover:border-accent/40",
              ]}
            >
              <div class="aspect-video overflow-hidden border-b-2 border-ink/10 bg-secondary">
                <img
                  src={goal.image.src}
                  alt={goal.image.alt}
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-contain transition-transform duration-700 group-hover:scale-[1.03]"
                />
              </div>
              <div class="p-7 md:p-8">
                <h3 class="text-xl font-bold leading-snug md:text-2xl">{goal.title}</h3>
                <p class="mt-3 leading-relaxed text-muted">{goal.text}</p>
                <p class="mt-4 border-l-2 border-accent/40 bg-accent/5 px-4 py-3 text-[0.95rem] font-medium leading-relaxed text-ink/80">
                  {goal.result}
                </p>
                <a
                  href={goal.href}
                  class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-accent transition-all group-hover:gap-3 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                  {goal.link}
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── SERVICES — outcomes in plain language ───────────────────────── -->
  <section class="section-padding bg-white" aria-labelledby="services-heading">
    <div class="container-custom">
      <div class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-xl">
          <span class="badge badge-accent mb-4">Services</span>
          <h2 id="services-heading" class="mt-4 text-4xl font-bold leading-[1.08] md:text-5xl">
            Everything you need to run and grow
          </h2>
        </div>
        <p class="max-w-md text-lg leading-relaxed text-muted">
          Clear scope, training for your team, and support after launch — included
          in every engagement.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {
          servicesEntries.map((entry, i) => {
            const service = entry.data;
            const outcome = serviceOutcomes[entry.id];
            const image = serviceImages[localizedEntryId(entry.id)];
            const isAlt = i % 2 === 1;
            return (
              <a
                href={`/services/${entry.id}`}
                class:list={[
                  "group flex flex-col overflow-hidden border-2 border-ink/10 bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-4",
                  isAlt
                    ? "hover:border-fire/50 focus-visible:outline-fire"
                    : "hover:border-accent/50 focus-visible:outline-accent",
                ]}
              >
                {image && (
                  <div class="aspect-4/3 overflow-hidden border-b-2 border-ink/10 bg-ink">
                    <img
                      src={image.src}
                      alt={image.alt}
                      width="1024"
                      height="768"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                    />
                  </div>
                )}
                <div class="flex flex-1 flex-col p-7">
                  <h3 class="text-xl font-bold leading-snug">{service.title}</h3>
                  <p class="mt-2 text-[0.95rem] font-bold leading-snug text-ink/80">
                    {outcome?.promise ?? service.shortDescription ?? service.description}
                  </p>
                  {outcome && (
                    <ul class="mt-4 flex-1 space-y-2.5">
                      {outcome.points.map((point) => (
                        <li class="flex items-start gap-2 text-sm leading-relaxed text-muted">
                          <svg
                            class:list={["mt-0.5 h-4 w-4 shrink-0", isAlt ? "text-fire" : "text-accent"]}
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                          </svg>
                          <span>{point}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  <span
                    class:list={[
                      "mt-6 inline-flex items-center gap-2 border-b-2 pb-0.5 text-sm font-bold transition-all group-hover:gap-3",
                      isAlt ? "border-fire/30 text-fire" : "border-accent/30 text-accent",
                    ]}
                  >
                    Learn more
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ── CLIENTS — range of customers we work with ───────────────────── -->
  <section id="clients" class="section-padding relative overflow-hidden bg-ink scroll-mt-24" aria-labelledby="clients-heading">
    <div class="pointer-events-none absolute inset-0 halftone-organic-accent opacity-15" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full bg-fire/10 blur-3xl" aria-hidden="true"></div>

    <div class="container-custom relative z-10">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="badge badge-fire mb-4">Clients</span>
        <h2 id="clients-heading" class="mt-4 text-4xl font-bold leading-[1.08] text-white md:text-5xl">
          Teams across industries, one partner
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-white/60">
          We work with growing brands and established operators around the world
          — in retail, trading, operations, and professional services.
        </p>
        <ul class="mt-6 flex flex-wrap items-center justify-center gap-2" aria-label="Industries we serve">
          {
            clientSectors.map((sector) => (
              <li class="border border-white/15 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white/55">
                {sector}
              </li>
            ))
          }
        </ul>
      </div>

      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {
          clients.map((client) => (
            <li class="flex items-center gap-3 border border-white/10 bg-ink-soft p-4">
              <LogoPlaceholder name={client.name} size="sm" gradient={client.gradient} class="shrink-0" />
              <div class="min-w-0">
                <p class="truncate text-sm font-bold text-white">{client.name}</p>
                <p class="truncate text-xs text-white/45">{client.sector}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── PROCESS — what happens after you contact us ─────────────────── -->
  <section class="section-padding bg-secondary" aria-labelledby="process-heading">
    <div class="container-custom">
      <div class="mb-12 mx-auto max-w-2xl text-center">
        <span class="badge badge-accent mb-4">How it works</span>
        <h2 id="process-heading" class="mt-4 text-4xl font-bold leading-[1.08] md:text-5xl">
          From first call to ongoing support
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          You always know what happens next — no surprises, no technical maze.
        </p>
      </div>

      <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          process.map((item) => (
            <li class="border-2 border-ink/10 bg-white p-7">
              <p class="text-4xl font-bold text-accent/30" aria-hidden="true">{item.step}</p>
              <h3 class="mt-3 text-lg font-bold leading-snug">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-10 text-center">
        <a href="/contact" class="btn-fire inline-block">Book a consultation</a>
        <p class="mt-4 text-sm font-medium text-muted">
          Prefer to look around first? <a href="/#clients" class="font-bold text-accent underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">See who we work with</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ── TESTIMONIALS — quieter supporting proof ─────────────────────── -->
  <section class="section-padding bg-white" aria-labelledby="testimonials-heading">
    <div class="container-custom">
      <div class="mb-12 mx-auto max-w-2xl text-center">
        <span class="badge badge-accent mb-4">Client voices</span>
        <h2 id="testimonials-heading" class="mt-4 text-4xl font-bold leading-[1.08] md:text-5xl">
          What it's like to work with us
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          testimonials.map((t) => (
            <figure class="flex flex-col border-2 border-ink/10 bg-secondary p-7">
              <span class="text-4xl font-bold leading-none text-accent/40" aria-hidden="true">&ldquo;</span>
              <blockquote class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-ink/75">
                <p>{t.quote}</p>
              </blockquote>
              <figcaption class="mt-6 border-t-2 border-ink/5 pt-5">
                <cite class="not-italic font-bold text-ink">{t.name}</cite>
                <p class="mt-1 text-sm text-muted">
                  {t.title}
                  <span class="text-border" aria-hidden="true">{" · "}</span>
                  {t.org}
                </p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── TECHNOLOGY — supporting detail, lower on the page ───────────── -->
  <section class="border-y-2 border-ink/10 bg-white py-12" aria-label="Technology we use">
    <div class="container-custom">
      <p class="mb-2 text-center text-xs font-bold uppercase tracking-widest text-ink/40">
        Built on proven technology
      </p>
      <p class="mx-auto mb-8 max-w-xl text-center text-sm leading-relaxed text-muted">
        We choose widely-used tools so your business is never locked into
        something obscure — and your team can always find support.
      </p>
      <TechnologyMarquee />
    </div>
  </section>

  <!-- ── BLOG — practical, not jargon ────────────────────────────────── -->
  {
    latestBlogPosts.length > 0 && (
      <section class="section-padding bg-secondary" aria-labelledby="blog-heading">
        <div class="container-custom">
          <div class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
            <div class="max-w-xl">
              <span class="badge badge-fire mb-4">Practical guides</span>
              <h2 id="blog-heading" class="mt-4 text-4xl font-bold leading-[1.08] md:text-5xl">
                Helpful reading, without the jargon
              </h2>
            </div>
            <p class="max-w-md text-lg leading-relaxed text-muted">
              Short guides on running operations, selling online, and choosing
              software with confidence.
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-3">
            {latestBlogPosts.map((post) => {
              const { title, description, pubDate, author } = post.data;
              const image = blogImages[localizedEntryId(post.id)];
              return (
                <a
                  href={`/blog/${post.id}`}
                  class="group flex flex-col overflow-hidden border-2 border-ink/10 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                  {image && (
                    <div class="aspect-video overflow-hidden border-b-2 border-ink/10 bg-ink">
                      <img
                        src={image.src}
                        alt={image.alt}
                        width="1024"
                        height="576"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      />
                    </div>
                  )}
                  <div class="flex flex-1 flex-col p-7">
                    <time
                      datetime={pubDate.toISOString()}
                      class="mb-3 text-xs font-bold uppercase tracking-wide text-muted"
                    >
                      {formatBlogDate(pubDate)}
                      {author ? ` · ${author}` : ""}
                    </time>
                    <h3 class="mb-3 text-lg font-bold leading-snug transition-colors group-hover:text-accent">
                      {title}
                    </h3>
                    <p class="mb-5 line-clamp-3 flex-1 text-sm leading-relaxed text-muted">
                      {description}
                    </p>
                    <span class="mt-auto inline-flex items-center gap-1.5 border-b-2 border-accent/30 pb-0.5 text-sm font-bold text-accent transition-all group-hover:gap-2.5">
                      Read article
                      <svg
                        class="h-4 w-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </a>
              );
            })}
          </div>

          <div class="mt-10 text-center">
            <a href="/blog" class="btn-outline">
              View all articles
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- ── FINAL CTA — explain the consultation ────────────────────────── -->
  <section class="section-padding relative overflow-hidden bg-ink" aria-labelledby="cta-heading">
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute left-1/4 top-1/2 h-[260px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/10 blur-3xl"></div>
      <div class="absolute right-1/4 top-1/2 h-[260px] w-[600px] -translate-y-1/2 translate-x-1/2 rounded-full bg-fire/10 blur-3xl"></div>
    </div>
    <div class="pointer-events-none absolute inset-0 halftone halftone-light opacity-15" aria-hidden="true"></div>
    <div class="container-custom relative z-10 mx-auto max-w-3xl text-center">
      <span class="badge mb-6" style="border: 2px solid var(--color-accent); color: var(--color-accent); background: rgba(40,175,162,0.1);">Free initial consultation</span>
      <h2 id="cta-heading" class="text-4xl font-bold leading-[1.08] text-white md:text-6xl">
        Tell us where your business feels stuck
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-white/60">
        You'll leave the first conversation with clear next steps — whether you
        work with us or not. No pressure, no jargon.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/contact" class="btn-fire px-8 py-3 text-lg">
          Book a consultation
        </a>
        <a
          href="/#clients"
          class="border-2 border-white/20 px-8 py-3 text-lg font-bold text-white/70 transition-colors duration-300 hover:border-white/40 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          See who we work with
        </a>
      </div>
      <p class="mt-8 text-sm font-medium text-white/45">
        <a href={business.telHref} class="transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">{business.phoneDisplay}</a>
        <span class="mx-2" aria-hidden="true">·</span>
        <a href={business.mailtoHref} class="transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">{business.emailDisplay}</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>
