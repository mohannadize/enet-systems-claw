---
import Layout from '../../layouts/Layout.astro';
import { buildAboutPage, siteUrl } from '../../lib/jsonld';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';


const values = [
  { title: 'Innovation', desc: 'We embrace new technologies and creative solutions to solve complex business challenges.' },
  { title: 'Quality', desc: 'Excellence in code, design, and service is non-negotiable. We deliver nothing less than the best.' },
  { title: 'Partnership', desc: 'Your success is our success. We work as an extension of your team, not just a vendor.' }
];

const stats = [
  { number: '10+', label: 'Years in Business' },
  { number: '150+', label: 'Projects Completed' },
  { number: '50+', label: 'Happy Clients' },
  { number: '20+', label: 'Team Members' }
];

const aboutDescription =
  "Learn about ENET Systems LTD—our team, values, and mission to deliver digital transformation for businesses around the world.";
---

<Layout
  title="About Us | ENET Systems LTD"
  description={aboutDescription}
  jsonLd={buildAboutPage({
    name: 'About Us | ENET Systems LTD',
    description: aboutDescription,
    url: siteUrl('/about'),
  })}
>
  <Navbar />

  <!-- Page Header — Bold ink hero -->
  <section class="pt-32 pb-16 relative overflow-hidden bg-ink">
    <div class="absolute inset-0">
      <div class="absolute inset-0 halftone halftone-light opacity-15" aria-hidden="true"></div>
      <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-fire/10 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <span class="badge badge-accent mb-6 opacity-0 animate-slide-up" style="border-color: var(--color-accent); color: var(--color-accent); background: rgba(40,175,162,0.1);">
        {'Your trusted partner in digital transformation since 2015'}
      </span>
      <h1 class="text-6xl md:text-8xl font-bold font-[family-name:var(--font-display)] text-white mb-4 opacity-0 animate-slide-up animate-delay-100 leading-[1.05]">
        {'About Us'}
      </h1>
    </div>
  </section>

  <!-- About Story -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="opacity-0 animate-slide-up">
          <span class="badge badge-fire mb-4">{'Our Story'}</span>
          <h2 class="text-4xl md:text-5xl font-bold font-[family-name:var(--font-display)] mt-4 mb-6 leading-[1.05]">
            {'Driving Digital Excellence Worldwide'}
          </h2>
          <div class="space-y-4 text-muted leading-relaxed text-[1.05rem]">
            <p>{'ENET Systems LTD was founded with a mission to help businesses around the world harness the power of technology for growth and innovation. Over the years, we have evolved into a comprehensive software solutions provider, serving clients across industries and geographies.'}</p>
            <p>{'Our team of experienced developers, designers, and business analysts work collaboratively to deliver solutions that not only meet technical requirements but also align with our clients\' business objectives. We believe in building long-term partnerships based on trust, transparency, and exceptional results.'}</p>
            <p>{'As an official Odoo Partner, we bring international best practices in enterprise resource planning to growing companies, helping them streamline operations and achieve digital maturity.'}</p>
          </div>
        </div>

        <div class="relative opacity-0 animate-slide-up animate-delay-200 p-8 md:p-12 max-w-lg mx-auto">
          <img
            src="/logo-dark.svg"
            alt="ENET Systems LTD"
            class="w-full"
            width="1099"
            height="478"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats — Dual gradient band -->
  <section class="py-20 section-gradient-dual relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 halftone-organic-light opacity-25 ht-mask-tb" aria-hidden="true"></div>
    <div class="container-custom relative z-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-x divide-white/30">
        {stats.map((stat, i) => (
          <div class="text-center opacity-0 animate-slide-up" style={`animation-delay: ${i * 100}ms`}>
            <div class="text-5xl md:text-7xl font-bold font-[family-name:var(--font-display)] text-white mb-2 tracking-tight">
              {stat.number}
            </div>
            <div class="text-white/80 font-bold text-sm uppercase tracking-wider">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="text-center mb-16">
        <span class="badge badge-accent mb-4 opacity-0 animate-slide-up">{'What We Believe'}</span>
        <h2 class="text-5xl md:text-6xl font-bold font-[family-name:var(--font-display)] mt-4 opacity-0 animate-slide-up animate-delay-100 leading-[1.05]">
          {'Our Core Values'}
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {values.map((value, i) => (
          <div
            class:list={[
              "p-8 bg-white border-2 text-center opacity-0 animate-slide-up transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl",
              i % 2 === 1 ? "border-fire/20 hover:border-fire hover:shadow-fire/10" : "border-accent/20 hover:border-accent hover:shadow-accent/10",
            ]}
            style={`animation-delay: ${i * 100}ms`}
          >
            <div class:list={[
              "w-12 h-1.5 mb-6 mx-auto",
              i % 2 === 1 ? "bg-fire" : "bg-accent",
            ]}></div>
            <h3 class:list={[
              "text-xl font-bold font-[family-name:var(--font-display)] mb-4",
              i % 2 === 1 ? "text-fire" : "text-accent",
            ]}>
              {value.title}
            </h3>
            <p class="text-muted text-sm leading-relaxed">
              {value.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding">
    <div class="container-custom text-center">
      <h2 class="text-4xl md:text-6xl font-bold font-[family-name:var(--font-display)] mb-6 leading-[1.05]">
        {'Let\'s Work Together'}
      </h2>
      <p class="text-muted mb-8 max-w-xl mx-auto text-lg">
        {'Ready to transform your business with technology? We\'re here to help.'}
      </p>
      <a href={'/contact'} class="btn-primary inline-block">{'Get in Touch'}</a>
    </div>
  </section>

  <Footer />
</Layout>
