---
import Layout from '../../layouts/Layout.astro';
import { buildAboutPage, siteUrl } from '../../lib/jsonld';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';


const values = [
  { title: 'Innovation', desc: 'We embrace new technologies and creative solutions to solve complex business challenges.' },
  { title: 'Quality', desc: 'Excellence in code, design, and service is non-negotiable. We deliver nothing less than the best.' },
  { title: 'Partnership', desc: 'Your success is our success. We work as an extension of your team, not just a vendor.' }
];

const founder = {
  name: 'Mohanad Hesham',
  role: 'Founder & CEO',
  linkedin: 'https://www.linkedin.com/in/mohannad977/'
};

const stats = [
  { number: '10+', label: 'Years in Business' },
  { number: '150+', label: 'Projects Completed' },
  { number: '50+', label: 'Happy Clients' },
  { number: '20+', label: 'Team Members' }
];

const aboutDescription =
  "Learn about ENET Systems LTD—our team, values, and mission to deliver digital transformation for businesses around the world.";
---

<Layout
  title="About Us | ENET Systems LTD"
  description={aboutDescription}
  jsonLd={buildAboutPage({
    name: 'About Us | ENET Systems LTD',
    description: aboutDescription,
    url: siteUrl('/about'),
  })}
>
  <Navbar />

  <!-- Page Header — Bold ink hero -->
  <section class="pt-32 pb-16 relative overflow-hidden bg-ink">
    <div class="absolute inset-0">
      <div class="absolute inset-0 halftone halftone-light opacity-15" aria-hidden="true"></div>
      <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-fire/10 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <span class="badge badge-accent mb-6 opacity-0 animate-slide-up" style="border-color: var(--color-accent); color: var(--color-accent); background: rgba(40,175,162,0.1);">
        {'Your trusted partner in digital transformation since 2015'}
      </span>
      <h1 class="text-6xl md:text-8xl font-bold font-[family-name:var(--font-display)] text-white mb-4 opacity-0 animate-slide-up animate-delay-100 leading-[1.05]">
        {'About Us'}
      </h1>
    </div>
  </section>

  <!-- About Story -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="opacity-0 animate-slide-up">
          <span class="badge badge-fire mb-4">{'Our Story'}</span>
          <h2 class="text-4xl md:text-5xl font-bold font-[family-name:var(--font-display)] mt-4 mb-6 leading-[1.05]">
            {'Driving Digital Excellence Worldwide'}
          </h2>
          <div class="space-y-4 text-muted leading-relaxed text-[1.05rem]">
            <p>{'ENET Systems LTD was founded with a mission to help businesses around the world harness the power of technology for growth and innovation. Over the years, we have evolved into a comprehensive software solutions provider, serving clients across industries and geographies.'}</p>
            <p>{'Our team of experienced developers, designers, and business analysts work collaboratively to deliver solutions that not only meet technical requirements but also align with our clients\' business objectives. We believe in building long-term partnerships based on trust, transparency, and exceptional results.'}</p>
            <p>{'As an official Odoo Partner, we bring international best practices in enterprise resource planning to growing companies, helping them streamline operations and achieve digital maturity.'}</p>
          </div>
        </div>

        <div class="relative opacity-0 animate-slide-up animate-delay-200">
          <!-- Bold geometric decorative graphic -->
          <div class="relative aspect-square max-w-md mx-auto">
            <div class="absolute inset-0 border-2 border-accent/20"></div>
            <div class="absolute top-8 left-8 right-8 bottom-8 border-2 border-fire/20"></div>
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-accent/10 rounded-full blur-2xl"></div>
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-fire/10 rounded-full blur-xl"></div>
            <!-- Center icon -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center gap-3">
              <div class="w-20 h-20 bg-ink flex items-center justify-center">
                <span class="text-3xl font-bold font-[family-name:var(--font-display)] text-gradient-dual">E</span>
              </div>
              <span class="text-xs font-bold uppercase tracking-widest text-muted">ENET Systems</span>
            </div>
            <!-- Corner accents -->
            <div class="absolute top-0 left-0 w-6 h-6 bg-accent"></div>
            <div class="absolute top-0 right-0 w-6 h-6 bg-fire"></div>
            <div class="absolute bottom-0 left-0 w-6 h-6 bg-fire"></div>
            <div class="absolute bottom-0 right-0 w-6 h-6 bg-accent"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats — Dual gradient band -->
  <section class="py-20 section-gradient-dual relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 halftone-organic-light opacity-25 ht-mask-tb" aria-hidden="true"></div>
    <div class="container-custom relative z-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-x divide-white/30">
        {stats.map((stat, i) => (
          <div class="text-center opacity-0 animate-slide-up" style={`animation-delay: ${i * 100}ms`}>
            <div class="text-5xl md:text-7xl font-bold font-[family-name:var(--font-display)] text-white mb-2 tracking-tight">
              {stat.number}
            </div>
            <div class="text-white/80 font-bold text-sm uppercase tracking-wider">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="text-center mb-16">
        <span class="badge badge-accent mb-4 opacity-0 animate-slide-up">{'What We Believe'}</span>
        <h2 class="text-5xl md:text-6xl font-bold font-[family-name:var(--font-display)] mt-4 opacity-0 animate-slide-up animate-delay-100 leading-[1.05]">
          {'Our Core Values'}
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {values.map((value, i) => (
          <div
            class:list={[
              "p-8 bg-white border-2 text-center opacity-0 animate-slide-up transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl",
              i % 2 === 1 ? "border-fire/20 hover:border-fire hover:shadow-fire/10" : "border-accent/20 hover:border-accent hover:shadow-accent/10",
            ]}
            style={`animation-delay: ${i * 100}ms`}
          >
            <div class:list={[
              "w-12 h-1.5 mb-6 mx-auto",
              i % 2 === 1 ? "bg-fire" : "bg-accent",
            ]}></div>
            <h3 class:list={[
              "text-xl font-bold font-[family-name:var(--font-display)] mb-4",
              i % 2 === 1 ? "text-fire" : "text-accent",
            ]}>
              {value.title}
            </h3>
            <p class="text-muted text-sm leading-relaxed">
              {value.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="section-padding bg-ink relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 halftone halftone-light opacity-15" aria-hidden="true"></div>
    <div class="pointer-events-none absolute top-0 right-0 w-96 h-96 bg-accent/10 rounded-full blur-3xl" aria-hidden="true"></div>

    <div class="container-custom relative z-10">
      <div class="text-center mb-16">
        <span class="badge badge-fire mb-4 opacity-0 animate-slide-up" style="border-color: var(--color-fire); color: var(--color-fire); background: rgba(255,107,53,0.1);">{'The Person Behind It'}</span>
        <h2 class="text-5xl md:text-6xl font-bold font-[family-name:var(--font-display)] mt-4 text-white opacity-0 animate-slide-up animate-delay-100 leading-[1.05]">
          {'Founder'}
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-center max-w-4xl mx-auto">
        <!-- Card -->
        <div class="flex justify-center lg:justify-end">
          <a
            href={founder.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-ink-soft overflow-hidden border-2 border-white/10 hover:border-accent/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-accent/10 opacity-0 animate-slide-up w-64"
          >
            <div class="h-48 bg-gradient-to-br from-accent/20 to-fire/10 flex items-center justify-center">
              <svg class="w-16 h-16 text-accent/40 group-hover:text-accent/70 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <div class="p-5 text-center">
              <h3 class="font-bold text-lg text-white mb-0.5">{founder.name}</h3>
              <p class="text-white/50 text-sm mb-4">{founder.role}</p>
              <span class="inline-flex items-center gap-1.5 text-xs text-accent font-bold">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                {'Connect on LinkedIn'}
              </span>
            </div>
          </a>
        </div>

        <!-- Bio -->
        <div class="opacity-0 animate-slide-up animate-delay-100 space-y-4 text-white/60 leading-relaxed text-[1.05rem]">
          <p>{'Mohanad Hesham is a Full Stack Web Developer with over 4 years of hands-on experience building web applications across a broad technology stack — PHP, Python, Node.js, SQL, and beyond.'}</p>
          <p>{'What sets Mohanad apart is an uncommon blend of technical depth and business acumen, forged through years of working with startups across multiple markets. That experience shaped a practical, results-first approach to software: build what works, ship fast, and keep improving.'}</p>
          <p>{'He founded ENET Systems with a simple conviction — that businesses everywhere deserve high-quality digital solutions built by people who genuinely care about outcomes. Every project at ENET carries that same ethos.'}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding">
    <div class="container-custom text-center">
      <h2 class="text-4xl md:text-6xl font-bold font-[family-name:var(--font-display)] mb-6 leading-[1.05]">
        {'Let\'s Work Together'}
      </h2>
      <p class="text-muted mb-8 max-w-xl mx-auto text-lg">
        {'Ready to transform your business with technology? We\'re here to help.'}
      </p>
      <a href={'/contact'} class="btn-primary inline-block">{'Get in Touch'}</a>
    </div>
  </section>

  <Footer />
</Layout>
