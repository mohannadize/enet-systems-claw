---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import LogoPlaceholder from '../../components/LogoPlaceholder.astro';
import { getCaseStudies, serviceLabel, serviceColors } from '../../lib/collections';
import { buildCaseStudyIndex, siteUrl } from '../../lib/jsonld';
import { t, type Locale } from '../../i18n/i18n';

const { locale } = Astro.props as { locale: Locale };
const L = (k: Parameters<typeof t>[1]) => t(locale, k);
const p = (path: string) => `/${locale}${path === "/" ? "" : path}`;

const caseStudies = await getCaseStudies(locale);

const caseStudyIndexDescription =
  "Explore how ENET Systems has helped brands across Kuwait and the MENA region transform their digital operations through e-commerce, ERP, and web development.";
const caseStudyIndexDescriptionAr =
  'استكشف كيف ساعدت ENET Systems العلامات التجارية في الكويت والمنطقة على تحويل عملياتها الرقمية من خلال التجارة الإلكترونية وأنظمة ERP وتطوير الويب.';
const caseStudySeo = locale === 'ar' ? caseStudyIndexDescriptionAr : caseStudyIndexDescription;
const featured = caseStudies.filter((cs) => cs.data.featured);
const rest = caseStudies.filter((cs) => !cs.data.featured);
---

<Layout
  title={locale === 'ar' ? 'دراسات الحالة | ENET Systems' : 'Case Studies | ENET Systems LTD'}
  description={caseStudySeo}
  jsonLd={buildCaseStudyIndex({
    name: locale === 'ar' ? 'دراسات الحالة | ENET Systems' : 'Case Studies | ENET Systems LTD',
    description: caseStudySeo,
    url: siteUrl(p('/case-studies')),
  })}
>
  <Navbar />

  <!-- Page Header — Bold ink hero -->
  <section class="pt-16 pb-16 relative overflow-hidden bg-ink">
    <div class="absolute inset-0">
      <div class="absolute inset-0 halftone halftone-light opacity-15" aria-hidden="true"></div>
      <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-fire/10 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <span class="inline-flex items-center gap-2 px-4 py-2 border-2 border-accent/40 bg-accent/10 text-accent text-sm font-bold mb-6 opacity-0 animate-slide-up">
        <span class="w-2 h-2 bg-accent animate-pulse"></span>
        {caseStudies.length} {L('cs.count')}
      </span>
      <h1 class="text-6xl md:text-8xl font-bold font-[family-name:var(--font-display)] text-white mb-4 opacity-0 animate-slide-up animate-delay-100 leading-[1.05]">
        {L('cs.title')}
      </h1>
      <p class="text-white/60 text-lg max-w-2xl mx-auto opacity-0 animate-slide-up animate-delay-200">
        {L('cs.subtitle')}
      </p>
    </div>
  </section>

  <!-- Featured Case Studies -->
  {featured.length > 0 && (
    <section class="pb-12 bg-secondary">
      <div class="container-custom">
        <div class="flex items-center gap-3 mb-10 opacity-0 animate-slide-up">
          <div class="h-px flex-1 bg-border"></div>
          <span class="text-xs font-medium uppercase tracking-widest text-muted px-3">{L('cs.featured')}</span>
          <div class="h-px flex-1 bg-border"></div>
        </div>

        <div class="grid md:grid-cols-2 gap-6 md:gap-8">
          {featured.map((cs, i) => {
            const study = cs.data;
            return (
              <a
                href={p(`/case-studies/${cs.id}`)}
                class="featured-card group relative bg-white overflow-hidden border-2 border-ink/10 hover:border-accent transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:shadow-accent/10 opacity-0 animate-slide-up"
                style={`animation-delay: ${i * 100}ms`}
              >
                <div class="absolute inset-0 bg-gradient-to-br from-accent/3 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                <div class="relative p-8 md:p-10">
                  <!-- Top row: logo + service badges -->
                  <div class="flex items-start justify-between gap-4 mb-8">
                    <LogoPlaceholder name={study.name} size="lg" gradient={study.gradient as any} />
                    <div class="flex flex-wrap gap-2 justify-end">
                      {study.services.map((svc) => (
                        <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium border ${serviceColors[svc]}`}>
                          {serviceLabel(svc, locale)}
                        </span>
                      ))}
                    </div>
                  </div>

                  <!-- Brand name + tagline -->
                  <h2 class="text-2xl md:text-3xl font-bold font-[family-name:var(--font-display)] mb-2 group-hover:text-accent transition-colors">
                    {study.name}
                  </h2>
                  {study.tagline && (
                    <p class="text-accent/70 text-sm font-medium mb-4">{study.tagline}</p>
                  )}
                  <p class="text-muted leading-relaxed">{study.desc}</p>

                  <!-- Read more -->
                  <div class="mt-8 flex items-center gap-2 text-sm font-semibold text-accent group-hover:gap-3 transition-all duration-300">
                    {L('common.readCaseStudy')}
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- All Case Studies Grid -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      {featured.length > 0 && (
        <div class="flex items-center gap-3 mb-10 opacity-0 animate-slide-up">
          <div class="h-px flex-1 bg-border"></div>
          <span class="text-xs font-medium uppercase tracking-widest text-muted px-3">{L('cs.all')}</span>
          <div class="h-px flex-1 bg-border"></div>
        </div>
      )}

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {rest.map((cs, i) => {
          const study = cs.data;
          return (
            <a
              href={p(`/case-studies/${cs.id}`)}
              class="case-card group relative bg-secondary rounded-2xl overflow-hidden border border-border hover:border-accent/30 transition-all duration-400 hover:-translate-y-1 hover:shadow-xl hover:shadow-zinc-900/10 opacity-0 animate-slide-up"
              style={`animation-delay: ${i * 60}ms`}
            >
              <div class="relative p-6">
                <!-- Logo + services row -->
                <div class="flex items-center justify-between gap-3 mb-5">
                  <LogoPlaceholder name={study.name} size="md" gradient={study.gradient as any} />
                  <div class="flex flex-wrap gap-1.5 justify-end">
                    {study.services.map((svc) => (
                      <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border ${serviceColors[svc]}`}>
                        {serviceLabel(svc, locale)}
                      </span>
                    ))}
                  </div>
                </div>

                <h3 class="font-bold text-lg font-[family-name:var(--font-display)] mb-1.5 group-hover:text-accent transition-colors">
                  {study.name}
                </h3>
                <p class="text-muted text-sm leading-relaxed line-clamp-2">{study.desc}</p>

                <div class="mt-5 flex items-center gap-1.5 text-xs font-semibold text-muted group-hover:text-accent transition-colors group-hover:gap-2.5 duration-300">
                  {L('common.readCaseStudy')}
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-ink relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-accent/8 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <h2 class="text-4xl md:text-6xl font-bold font-[family-name:var(--font-display)] mb-4 text-white opacity-0 animate-slide-up leading-[1.05]">
        {L('cs.wantResults')}
      </h2>
      <p class="text-white/60 mb-8 max-w-xl mx-auto text-lg opacity-0 animate-slide-up animate-delay-100">
        {L('cs.ctaDesc')}
      </p>
      <div class="flex flex-wrap justify-center gap-4 opacity-0 animate-slide-up animate-delay-200">
        <a href={p('/contact')} class="btn-fire text-lg px-8 py-4">{L('common.startAProject')}</a>
        <a href={p('/services')} class="btn-outline-accent text-lg px-8 py-4">{L('common.ourServices')}</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .featured-card {
    position: relative;
    overflow: hidden;
  }

  .case-card {
    position: relative;
    overflow: hidden;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
