---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getBlogPosts } from '../../lib/collections';
import { buildBlogPosting, siteUrl } from '../../lib/jsonld';
import { blogImages, localizedEntryId } from '../../data/editorial-images';

const { entry } = Astro.props as { entry: any };
const { Content } = await render(entry);

const { title, description, pubDate, updatedDate, author, tags } = entry.data;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const allPosts = await getBlogPosts();
const tagSet = new Set((tags ?? []) as string[]);
const related = allPosts
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => {
    const score = (post: typeof a) =>
      (post.data.tags ?? []).filter((t) => tagSet.has(t)).length;
    return score(b) - score(a);
  })
  .slice(0, 3);

const postUrl = siteUrl(`/blog/${entry.id}`);
const editorialImage = blogImages[localizedEntryId(entry.id)];
---

<Layout
  title={`${title} | ${'Blog'} | ENET Systems`}
  description={description}
  jsonLd={buildBlogPosting({
    headline: title,
    description,
    url: postUrl,
    datePublished: pubDate,
    dateModified: updatedDate,
    author,
    keywords: tags,
  })}
>
  <Navbar />

  <article>
    <header class="relative overflow-hidden border-b-2 border-ink/10 bg-ink">
      <div class="absolute inset-0">
        <div class="absolute inset-0 halftone halftone-dark opacity-50 ht-mask-b" aria-hidden="true"></div>
        <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-fire/10 rounded-full blur-3xl"></div>
      </div>

      <div class="container-custom relative z-10 grid items-center gap-10 pt-28 pb-14 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-14 lg:pt-32 lg:pb-16">
        <div>
          <nav class="mb-8 flex items-center gap-2 text-sm text-white/50" aria-label="Breadcrumb">
            <a href={'/blog'} class="group flex items-center gap-1.5 hover:text-accent transition-colors">
              <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5 rtl:group-hover:translate-x-0.5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              {'Blog'}
            </a>
          </nav>

          <div class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-white/50">
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            {author && (
              <>
                <span class="text-white/20" aria-hidden="true">·</span>
                <span>{author}</span>
              </>
            )}
            {updatedDate && (
              <>
                <span class="text-white/20" aria-hidden="true">·</span>
                <span>{'Updated'} {formatDate(updatedDate)}</span>
              </>
            )}
          </div>

          <h1 class="mb-5 text-4xl font-bold leading-[1.05] text-white md:text-6xl">
            {title}
          </h1>
          <p class="max-w-xl text-lg leading-relaxed text-white/65">{description}</p>

          {tags && tags.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="border-2 border-accent/40 bg-accent/10 px-3 py-1 text-xs font-bold text-accent">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>

        {editorialImage && (
          <figure class="relative">
            <div class="relative aspect-[16/10] overflow-hidden border-2 border-white/15 shadow-bold-accent">
              <img
                src={editorialImage.src}
                alt={editorialImage.alt}
                width="1024"
                height="576"
                fetchpriority="high"
                class="h-full w-full object-cover"
              />
              <div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-white/10" aria-hidden="true"></div>
            </div>
          </figure>
        )}
      </div>
    </header>

    <section class="bg-secondary py-14 md:py-20">
      <div class="container-custom">
        <div class="mx-auto max-w-[42rem] prose-content blog-prose">
          <Content />
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="border-t-2 border-ink/10 bg-white pb-20 pt-14 md:pb-28 md:pt-16">
        <div class="container-custom">
          <div class="mb-10 flex items-end justify-between gap-6">
            <div>
              <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-muted">{'Keep reading'}</p>
              <h2 class="text-3xl font-bold md:text-4xl">{'More posts'}</h2>
            </div>
            <a href="/blog" class="hidden shrink-0 text-sm font-bold text-accent underline-offset-4 hover:underline sm:inline">
              {'All articles'}
            </a>
          </div>
          <ul class="grid gap-6 md:grid-cols-3">
            {related.map((rp) => {
              const image = blogImages[localizedEntryId(rp.id)];
              return (
                <li>
                  <a
                    href={`/blog/${rp.id}`}
                    class="group flex h-full flex-col overflow-hidden border-2 border-ink/10 bg-white transition-all hover:-translate-y-1 hover:border-accent hover:shadow-lg hover:shadow-accent/10"
                  >
                    {image && (
                      <div class="aspect-video overflow-hidden border-b-2 border-ink/10 bg-ink">
                        <img
                          src={image.src}
                          alt={image.alt}
                          width="1024"
                          height="576"
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                        />
                      </div>
                    )}
                    <div class="flex flex-1 flex-col p-5">
                      <span class="mb-2 text-xs font-bold uppercase tracking-wide text-muted">
                        {rp.data.pubDate.toLocaleDateString('en-GB', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric',
                        })}
                      </span>
                      <span class="font-bold font-[family-name:var(--font-display)] leading-snug transition-colors group-hover:text-accent">
                        {rp.data.title}
                      </span>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )}
  </article>

  <Footer />
</Layout>

<style>
  .blog-prose :global(p:first-of-type) {
    font-size: 1.2rem;
    line-height: 1.75;
    color: #27272a;
  }

  .prose-content :global(h2) {
    font-size: 1.65rem;
    font-weight: 700;
    font-family: var(--font-display);
    color: #0a0a12;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    padding-bottom: 0;
    border-bottom: none;
    position: relative;
  }

  .prose-content :global(h2::before) {
    content: '';
    display: block;
    width: 2.25rem;
    height: 3px;
    background: var(--color-accent, #28afa2);
    margin-bottom: 0.85rem;
  }

  .prose-content :global(h3) {
    font-size: 1.2rem;
    font-weight: 700;
    font-family: var(--font-display);
    color: #0a0a12;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose-content :global(p) {
    color: #3f3f46;
    line-height: 1.85;
    margin-bottom: 1.35rem;
    font-size: 1.0625rem;
  }

  .prose-content :global(ul) {
    list-style: none;
    padding: 0;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .prose-content :global(ul li) {
    color: #3f3f46;
    padding-left: 1.5rem;
    position: relative;
    line-height: 1.75;
  }

  .prose-content :global(ul li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    background: var(--color-accent, #28afa2);
  }

  .prose-content :global(ul li strong) {
    color: #0a0a12;
    font-weight: 600;
  }

  .prose-content :global(a) {
    color: var(--color-accent, #28afa2);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.2s;
  }

  .prose-content :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .prose-content :global(code) {
    font-size: 0.875em;
    background: rgba(0, 0, 0, 0.05);
    padding: 0.2em 0.4em;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }
</style>
