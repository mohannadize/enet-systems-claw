---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { buildServicePage, siteUrl } from '../../lib/jsonld';
import { getServiceSubpages, serviceLabel } from '../../lib/collections';

const { entry } = Astro.props as { entry: any };
const { Content } = await render(entry);

const slug = entry.id;

// Determine whether this is a hub (top-level, no slash) or a subpage
const isHub = !slug.includes('/');
const serviceRoot = isHub ? slug : slug.split('/')[0];

// Load siblings for the sub-nav (all entries sharing the same root, excluding the hub itself)
const siblings = await getServiceSubpages(serviceRoot);

// Hub entry for breadcrumb/sub-nav
const allEntries = await getCollection('services');
const hubEntry = allEntries.find((e) => e.id === serviceRoot);

// Service root labels for the hub badge
const serviceRootColors: Record<string, string> = {
  'web-development': 'bg-accent/10 text-accent border-accent/20',
  'odoo-erp': 'bg-purple-500/10 text-purple-700 border-purple-500/20',
  'mobile-apps': 'bg-blue-500/10 text-blue-700 border-blue-500/20',
  'seo-optimization': 'bg-green-500/10 text-green-700 border-green-500/20',
};
const rootLabelKey: Record<string, 'web' | 'odoo' | 'mobile'> = {
  'web-development': 'web',
  'odoo-erp': 'odoo',
  'mobile-apps': 'mobile',
  'seo-optimization': 'web',
};
const badgeLabel = rootLabelKey[serviceRoot]
  ? serviceLabel(rootLabelKey[serviceRoot])
  : (hubEntry?.data.title ?? serviceRoot);
const badgeColor = serviceRootColors[serviceRoot] ?? 'bg-accent/10 text-accent border-accent/20';
const badge = { label: badgeLabel, color: badgeColor };

const servicePageUrl = siteUrl(`/services/${slug}`);
---

<Layout
  title={`${entry.data.title} | ${'Services'} | ENET Systems`}
  description={entry.data.description}
  jsonLd={buildServicePage({
    title: entry.data.title,
    description: entry.data.description,
    url: servicePageUrl,
    features: entry.data.features,
  })}
>
  <Navbar />

  <!-- Page Hero -->
  <section class="pt-16 pb-16 relative overflow-hidden bg-ink">
    <div class="absolute inset-0">
      <div class="absolute inset-0 halftone halftone-light opacity-15" aria-hidden="true"></div>
      <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-fire/10 rounded-full blur-3xl"></div>
    </div>

    <div class="container-custom relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-white/50 mb-10" aria-label="Breadcrumb">
        <a href={'/services'} class="hover:text-accent transition-colors group inline-flex items-center gap-1">
          <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5 rtl:group-hover:translate-x-0.5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          {'Services'}
        </a>
        {!isHub && hubEntry && (
          <>
            <span class="opacity-30">/</span>
            <a href={`/services/${serviceRoot}`} class="hover:text-accent transition-colors">
              {hubEntry.data.title}
            </a>
          </>
        )}
      </nav>

      <div class="flex flex-col gap-5 max-w-3xl">
        <span class={`inline-flex w-fit items-center px-3 py-1 rounded-full text-xs font-medium uppercase tracking-wider border ${badge.color}`}>
          {badge.label}
        </span>
        {isHub && entry.data.icon && (
          <div class="text-accent [&_svg]:w-14 [&_svg]:h-14" set:html={entry.data.icon} />
        )}
        <h1 class="text-4xl md:text-6xl font-bold font-[family-name:var(--font-display)] text-white leading-[1.05]">
          {entry.data.title}
        </h1>
        <p class="text-white/60 text-lg leading-relaxed">
          {entry.data.description}
        </p>

        {isHub && entry.data.features && entry.data.features.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-1">
            {entry.data.features.map((f: string) => (
              <span class="px-3 py-1 bg-white/5 border-2 border-white/10 text-sm font-medium text-white/70">
                {f}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Sub-nav (shown when there are sibling subpages) -->
  {siblings.length > 0 && (
    <div class="sticky top-0 z-20 border-b-2 border-ink/10 bg-primary/95 backdrop-blur-sm">
      <div class="container-custom">
        <nav class="flex items-center gap-1 overflow-x-auto py-3 no-scrollbar" aria-label="Service sub-navigation">
          <a
            href={`/services/${serviceRoot}`}
            class={`shrink-0 px-4 py-2 text-sm font-bold transition-all border-2 ${
              isHub
                ? 'bg-accent/10 text-accent border-accent/30'
                : 'text-muted border-transparent hover:text-accent hover:border-accent/20 hover:bg-accent/5'
            }`}
          >
            {'Overview'}
          </a>
          {siblings.map((sibling) => (
            <a
              href={`/services/${sibling.id}`}
              class={`shrink-0 px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
                entry.id === sibling.id
                  ? 'bg-accent/10 text-accent border border-accent/20'
                  : 'text-muted hover:text-zinc-900 hover:bg-zinc-100'
              }`}
            >
              {sibling.data.title}
            </a>
          ))}
        </nav>
      </div>
    </div>
  )}

  <!-- MDX Content -->
  <section class="section-padding bg-secondary">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto prose-content">
        <Content />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-ink relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-accent/5 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <h2 class="text-4xl md:text-6xl font-bold font-[family-name:var(--font-display)] mb-4 text-white leading-[1.05]">
        {'Ready to Get Started?'}
      </h2>
      <p class="text-white/60 mb-8 max-w-xl mx-auto text-lg">
        {'Let\'s talk about your project and how we can help bring it to life.'}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={'/contact'} class="btn-fire text-lg px-8 py-4">{'Get in Touch'}</a>
        <a href={'/services'} class="btn-outline-accent text-lg px-8 py-4">{'All Services'}</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  /* Prose styles for MDX content */
  .prose-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    font-family: var(--font-display);
    color: #18181b;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border, rgba(0,0,0,0.08));
  }

  .prose-content :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    color: #18181b;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .prose-content :global(p) {
    color: var(--color-muted, rgba(0,0,0,0.6));
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }

  .prose-content :global(ul) {
    list-style: none;
    padding: 0;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .prose-content :global(ul li) {
    color: var(--color-muted, rgba(0,0,0,0.6));
    padding-left: 1.5rem;
    position: relative;
    line-height: 1.7;
  }

  .prose-content :global(ul li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent, #f59e0b);
  }

  .prose-content :global(ul li strong) {
    color: #18181b;
    font-weight: 600;
  }

  .prose-content :global(ol) {
    list-style: none;
    padding: 0;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    counter-reset: ol-counter;
  }

  .prose-content :global(ol li) {
    color: var(--color-muted, rgba(0,0,0,0.6));
    padding-left: 2rem;
    position: relative;
    line-height: 1.7;
    counter-increment: ol-counter;
  }

  .prose-content :global(ol li::before) {
    content: counter(ol-counter);
    position: absolute;
    left: 0;
    top: 0;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    background: var(--color-accent, #f59e0b);
    color: #000;
    font-size: 0.7rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .prose-content :global(ol li strong),
  .prose-content :global(ul li strong) {
    color: #18181b;
    font-weight: 600;
  }

  .prose-content :global(a) {
    color: var(--color-accent, #f59e0b);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.2s;
  }

  .prose-content :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .prose-content :global(code) {
    font-size: 0.875em;
    background: rgba(0,0,0,0.05);
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    border: 1px solid rgba(0,0,0,0.1);
  }

  .prose-content :global(pre) {
    background: rgba(0,0,0,0.03);
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 0.75rem;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }

  .prose-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }
</style>
