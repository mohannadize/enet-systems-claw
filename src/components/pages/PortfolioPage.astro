---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import LogoPlaceholder from '../../components/LogoPlaceholder.astro';
import { getPortfolioByCategory, getPortfolioCategories, entryLocale } from '../../lib/collections';
import { buildPortfolioIndex, siteUrl } from '../../lib/jsonld';
import { t, type Locale } from '../../i18n/i18n';

const { locale } = Astro.props as { locale: Locale };
const L = (k: Parameters<typeof t>[1]) => t(locale, k);
const p = (path: string) => `/${locale}${path === "/" ? "" : path}`;

const portfolioByCategory = await getPortfolioByCategory(locale);

const portfolioIndexDescription =
  "A selection of web, e-commerce, Odoo ERP, and mobile work delivered by ENET Systems across Kuwait and the MENA region.";
const portfolioIndexDescriptionAr =
  'مجموعة مختارة من أعمال الويب والتجارة الإلكترونية وأودو ERP وتطبيقات الجوال التي نفذتها ENET Systems في الكويت ومنطقة الشرق الأوسط وشمال أفريقيا.';
const portfolioSeo = locale === 'ar' ? portfolioIndexDescriptionAr : portfolioIndexDescription;
const categories = getPortfolioCategories(locale);
const allEntries = (await getCollection('portfolio')).filter((e) => entryLocale(e) === locale);
const projectCount = allEntries.length;
---

<Layout
  title={locale === 'ar' ? 'أعمالنا | ENET Systems' : 'Portfolio | ENET Systems LTD'}
  description={portfolioSeo}
  jsonLd={buildPortfolioIndex({
    name: locale === 'ar' ? 'أعمالنا | ENET Systems' : 'Portfolio | ENET Systems LTD',
    description: portfolioSeo,
    url: siteUrl(p('/portfolio')),
  })}
>
  <Navbar />
  
  <!-- Page Header — Bold ink hero -->
  <section class="pt-32 pb-16 relative overflow-hidden bg-ink">
    <div class="absolute inset-0">
      <div class="absolute inset-0 halftone halftone-light opacity-15" aria-hidden="true"></div>
      <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-fire/10 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <span class="inline-flex items-center gap-2 px-4 py-2 border-2 border-accent/40 bg-accent/10 text-accent text-sm font-bold mb-6 opacity-0 animate-slide-up">
        <span class="w-2 h-2 bg-accent animate-pulse"></span>
        {projectCount}+ {L('portfolio.projectsDelivered')}
      </span>
      <h1 class="text-6xl md:text-8xl font-bold font-[family-name:var(--font-display)] text-white mb-4 opacity-0 animate-slide-up animate-delay-100 leading-[1.05]">
        {L('portfolio.title')}
      </h1>
      <p class="text-white/60 text-lg max-w-2xl mx-auto opacity-0 animate-slide-up animate-delay-200">
        {L('portfolio.subtitle')}
      </p>
    </div>
  </section>

  <!-- Portfolio Grid -->
  <section class="section-padding bg-secondary">
    <div class="container-custom">
      {categories.map((cat, catIndex) => (
        <div class="mb-24 last:mb-0" data-category={cat.id}>
          <!-- Category Header -->
          <div class="flex flex-col md:flex-row md:items-center gap-4 mb-10 opacity-0 animate-slide-up" style={`animation-delay: ${catIndex * 100}ms`}>
            <div class={`w-14 h-14 bg-${cat.gradient}-500/10 flex items-center justify-center text-${cat.gradient}-600 border-2 border-${cat.gradient}-500/20`} set:html={cat.icon} />
            <div>
              <h2 class="text-3xl md:text-4xl font-bold font-[family-name:var(--font-display)]">{cat.title}</h2>
              <p class="text-muted mt-1">{cat.desc}</p>
            </div>
          </div>
          
          <!-- Projects Grid -->
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
            {cat.id === 'ecommerce' && portfolioByCategory.ecommerce.map((entry, i) => {
              const project = entry.data;
              return (
              <a 
                href={p(`/portfolio/${entry.id}`)}
                class="portfolio-card group relative bg-white p-6 border-2 border-ink/10 hover:border-accent transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-accent/10 opacity-0 animate-slide-up"
                style={`animation-delay: ${(catIndex * 4 + i) * 50}ms`}
                aria-label={`${L('portfolio.viewCaseStudy')} · ${project.name}`}
              >
                <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                
                <div class="relative">
                  <div class="mb-4 transform group-hover:scale-110 transition-transform duration-300">
                    <LogoPlaceholder name={project.name} size="md" gradient={project.gradient as any} class="group-hover:shadow-accent/20" />
                  </div>
                  
                  <h3 class="font-semibold text-zinc-900 group-hover:text-accent transition-colors mb-1 line-clamp-1">
                    {project.name}
                  </h3>
                  <span class="text-xs text-muted flex items-center gap-1">
                    <svg class="w-3 h-3 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                    {L('portfolio.viewCaseStudy')}
                  </span>
                </div>
              </a>
            );
            })}
            
            {cat.id === 'web' && portfolioByCategory.web.map((entry, i) => {
              const project = entry.data;
              return (
              <a 
                href={p(`/portfolio/${entry.id}`)}
                class="portfolio-card group relative bg-secondary rounded-2xl p-6 border border-border hover:border-blue-500/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:shadow-blue-500/5 opacity-0 animate-slide-up"
                style={`animation-delay: ${(catIndex * 4 + i) * 50}ms`}
                aria-label={`${L('portfolio.viewCaseStudy')} · ${project.name}`}
              >
                <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                
                <div class="relative">
                  <div class="mb-4 transform group-hover:scale-110 transition-transform duration-300">
                    <LogoPlaceholder name={project.name} size="md" gradient={project.gradient as any} />
                  </div>
                  
                  <h3 class="font-semibold text-zinc-900 group-hover:text-blue-600 transition-colors mb-1 line-clamp-1">
                    {project.name}
                  </h3>
                  <span class="text-xs text-muted flex items-center gap-1">
                    <svg class="w-3 h-3 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                    {L('portfolio.viewCaseStudy')}
                  </span>
                </div>
              </a>
            );
            })}
            
            {cat.id === 'odoo' && portfolioByCategory.odoo.map((entry, i) => {
              const project = entry.data;
              return (
              <a 
                href={p(`/portfolio/${entry.id}`)}
                class="portfolio-card group relative bg-secondary rounded-2xl p-6 border border-border hover:border-purple-500/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:shadow-purple-500/5 opacity-0 animate-slide-up"
                style={`animation-delay: ${(catIndex * 4 + i) * 50}ms`}
                aria-label={`${L('portfolio.viewCaseStudy')} · ${project.name}`}
              >
                <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-purple-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                
                <div class="relative">
                  <div class="mb-4 transform group-hover:scale-110 transition-transform duration-300">
                    <LogoPlaceholder name={project.name} size="md" gradient={project.gradient as any} />
                  </div>
                  
                  <h3 class="font-semibold text-zinc-900 group-hover:text-purple-600 transition-colors mb-1 line-clamp-1">
                    {project.name}
                  </h3>
                  <span class="text-xs text-muted flex items-center gap-1">
                    <svg class="w-3 h-3 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                    {L('portfolio.viewCaseStudy')}
                  </span>
                </div>
              </a>
            );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-16 border-y border-border">
    <div class="container-custom">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center opacity-0 animate-slide-up">
          <div class="text-4xl md:text-5xl font-bold font-[family-name:var(--font-display)] text-accent mb-2">
            {projectCount}+
          </div>
          <div class="text-muted">{L('portfolio.projectsDelivered')}</div>
        </div>
        <div class="text-center opacity-0 animate-slide-up animate-delay-100">
          <div class="text-4xl md:text-5xl font-bold font-[family-name:var(--font-display)] text-accent mb-2">
            3
          </div>
          <div class="text-muted">{L('portfolio.serviceCategories')}</div>
        </div>
        <div class="text-center opacity-0 animate-slide-up animate-delay-200">
          <div class="text-4xl md:text-5xl font-bold font-[family-name:var(--font-display)] text-accent mb-2">
            10+
          </div>
          <div class="text-muted">{L('portfolio.yearsExperience')}</div>
        </div>
        <div class="text-center opacity-0 animate-slide-up animate-delay-300">
          <div class="text-4xl md:text-5xl font-bold font-[family-name:var(--font-display)] text-accent mb-2">
            50+
          </div>
          <div class="text-muted">{L('portfolio.happyClients')}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-ink relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/10 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <h2 class="text-4xl md:text-6xl font-bold font-[family-name:var(--font-display)] mb-6 text-white opacity-0 animate-slide-up leading-[1.05]">
        {L('portfolio.startYourProject')}
      </h2>
      <p class="text-white/60 mb-8 max-w-xl mx-auto text-lg opacity-0 animate-slide-up animate-delay-100">
        {L('portfolio.ctaDesc')}
      </p>
      <div class="flex flex-wrap justify-center gap-4 opacity-0 animate-slide-up animate-delay-200">
        <a href={p('/contact')} class="btn-fire text-lg px-8 py-4">{L('common.getInTouch')}</a>
        <a href={p('/services')} class="btn-outline-accent text-lg px-8 py-4">{L('common.ourServices')}</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .portfolio-card {
    position: relative;
    overflow: hidden;
  }
  
  .portfolio-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 0%, rgba(245, 158, 11, 0.03) 100%);
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  
  .portfolio-card:hover::before {
    opacity: 1;
  }
  
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
