---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import TechnologyMarquee from '../../components/TechnologyMarquee.astro';
import { getServices } from '../../lib/collections';
import { buildWebPage, siteUrl } from '../../lib/jsonld';
import { localizedEntryId, serviceImages } from '../../data/editorial-images';


const servicesEntries = await getServices();

const servicesPageDescription =
  "Comprehensive digital solutions to power your business growth — web development, Odoo ERP, mobile apps, agentic automation, and more.";

const process = [
  { step: '01', title: 'Discovery', desc: 'We analyze requirements and create a detailed project roadmap.' },
  { step: '02', title: 'Design', desc: 'Our design team creates intuitive interfaces aligned with your brand.' },
  { step: '03', title: 'Development', desc: 'Expert developers build using best practices and cutting-edge tech.' },
  { step: '04', title: 'Testing', desc: 'Rigorous QA ensures your product is bug-free and optimal.' },
  { step: '05', title: 'Deployment', desc: 'We deploy to production and ensure smooth launch.' },
  { step: '06', title: 'Support', desc: 'Ongoing maintenance to keep your solution running at peak.' }
];

---

<Layout
  title="Services | ENET Systems LTD"
  description={servicesPageDescription}
  jsonLd={buildWebPage({
    name: 'Services | ENET Systems LTD',
    description: servicesPageDescription,
    url: siteUrl('/services'),
  })}
>
  <Navbar />
  
  <!-- Page Header — Bold ink hero -->
  <section class="pt-32 pb-16 relative overflow-hidden bg-ink">
    <div class="absolute inset-0">
      <div class="absolute inset-0 halftone halftone-light opacity-15" aria-hidden="true"></div>
      <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-fire/10 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <span class="badge mb-6 opacity-0 animate-slide-up" style="border: 2px solid var(--color-fire); color: var(--color-fire); background: rgba(255,107,53,0.1);">
        {'Comprehensive digital solutions to power your business growth'}
      </span>
      <h1 class="text-6xl md:text-8xl font-bold font-[family-name:var(--font-display)] text-white mb-4 opacity-0 animate-slide-up animate-delay-100 leading-[1.05]">
        {'Our Services'}
      </h1>
    </div>
  </section>

  <!-- Services Detail -->
  <section class="section-padding">
    <div class="container-custom space-y-16">
      {servicesEntries.map((entry, i) => {
        const service = entry.data;
        const image = serviceImages[localizedEntryId(entry.id)];
        return (
        <div class={`grid lg:grid-cols-2 gap-12 items-center`}>
          <div class="opacity-0 animate-slide-up" style={`animation-delay: ${i * 100}ms`}>
            <div class="w-16 h-16 bg-accent/10 flex items-center justify-center mb-6 text-accent [&_svg]:w-8 [&_svg]:h-8" set:html={service.icon} />
            <h2 class="text-4xl md:text-5xl font-bold font-[family-name:var(--font-display)] mb-4 leading-[1.05]">
              {service.title}
            </h2>
            <p class="text-muted leading-relaxed mb-6">
              {service.description}
            </p>
            <div class="flex flex-wrap gap-2 mb-6">
              {service.features?.map((feature: string) => (
                <span class="px-3 py-1 bg-secondary border-2 border-ink/10 text-sm font-medium text-muted">
                  {feature}
                </span>
              ))}
            </div>
            <a href={`/services/${entry.id}`} class="btn-fire inline-flex items-center gap-2 group">
              {'Learn More'}
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
          
          <div class="opacity-0 animate-slide-up animate-delay-200" style={`animation-delay: ${i * 100 + 100}ms`}>
            <div class="group relative aspect-4/3 max-w-xl mx-auto overflow-hidden border-2 border-ink/10 bg-ink shadow-bold">
              {image && (
                <img
                  src={image.src}
                  alt={image.alt}
                  width="1024"
                  height="768"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.025]"
                />
              )}
              <div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-white/10" aria-hidden="true"></div>
            </div>
          </div>
        </div>
        );
      })}
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="py-12 bg-white border-y-2 border-ink/10">
    <div class="container-custom text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-ink/40 mb-6">{'Technologies We Use'}</p>
      <TechnologyMarquee />
    </div>
  </section>

  <!-- Process -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="text-center mb-16">
        <span class="text-accent text-sm font-medium uppercase tracking-wider">{'How We Work'}</span>
        <h2 class="text-3xl md:text-4xl font-bold font-[family-name:var(--font-display)] mt-4">
          {'Our Development Process'}
        </h2>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {process.map((item, i) => (
          <div class="p-6 rounded-2xl bg-secondary border border-border hover:border-accent/30 transition-all duration-300 opacity-0 animate-slide-up" style={`animation-delay: ${i * 100}ms`}>
            <div class="text-4xl font-bold font-[family-name:var(--font-display)] text-accent/30 mb-4">
              {item.step}
            </div>
            <h3 class="text-lg font-semibold mb-2">{item.title}</h3>
            <p class="text-muted text-sm">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-ink relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[200px] bg-accent/10 rounded-full blur-3xl"></div>
      <div class="absolute top-0 right-1/3 w-[300px] h-[200px] bg-fire/10 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <h2 class="text-4xl md:text-6xl font-bold font-[family-name:var(--font-display)] mb-6 text-white leading-[1.05]">
        {'Ready to Start Your Project?'}
      </h2>
      <p class="text-white/60 mb-8 max-w-xl mx-auto text-lg">
        {'Let\'s discuss how we can help bring your vision to life.'}
      </p>
      <a href={'/contact'} class="btn-fire inline-block">{'Get in Touch'}</a>
    </div>
  </section>

  <Footer />
</Layout>
