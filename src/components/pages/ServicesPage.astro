---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import TechnologyMarquee from '../../components/TechnologyMarquee.astro';
import { getServices } from '../../lib/collections';
import { buildWebPage, siteUrl } from '../../lib/jsonld';
import { t, type Locale } from '../../i18n/i18n';

const { locale } = Astro.props as { locale: Locale };
const L = (k: Parameters<typeof t>[1]) => t(locale, k);
const p = (path: string) => `/${locale}${path === "/" ? "" : path}`;

const servicesEntries = await getServices(locale);

const servicesPageDescription =
  "Comprehensive digital solutions to power your business growth — web development, Odoo ERP, mobile apps, SEO, and more.";
const servicesPageDescriptionAr =
  'حلول رقمية متكاملة لدفع نمو أعمالك — تطوير الويب، أودو ERP، تطبيقات الجوال، تحسين محركات البحث والمزيد.';
const servicesSeo = locale === 'ar' ? servicesPageDescriptionAr : servicesPageDescription;

const process = [
  { step: '01', title: L('services.process.1'), desc: L('services.process.1.desc') },
  { step: '02', title: L('services.process.2'), desc: L('services.process.2.desc') },
  { step: '03', title: L('services.process.3'), desc: L('services.process.3.desc') },
  { step: '04', title: L('services.process.4'), desc: L('services.process.4.desc') },
  { step: '05', title: L('services.process.5'), desc: L('services.process.5.desc') },
  { step: '06', title: L('services.process.6'), desc: L('services.process.6.desc') }
];

---

<Layout
  title={locale === 'ar' ? 'خدماتنا | ENET Systems' : 'Services | ENET Systems LTD'}
  description={servicesSeo}
  jsonLd={buildWebPage({
    name: locale === 'ar' ? 'خدماتنا | ENET Systems' : 'Services | ENET Systems LTD',
    description: servicesSeo,
    url: siteUrl(p('/services')),
  })}
>
  <Navbar />
  
  <!-- Page Header — Bold ink hero -->
  <section class="pt-32 pb-16 relative overflow-hidden bg-ink">
    <div class="absolute inset-0">
      <div class="absolute inset-0 halftone halftone-light opacity-15" aria-hidden="true"></div>
      <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-fire/10 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <span class="badge mb-6 opacity-0 animate-slide-up" style="border: 2px solid var(--color-fire); color: var(--color-fire); background: rgba(255,107,53,0.1);">
        {L('services.subtitle')}
      </span>
      <h1 class="text-6xl md:text-8xl font-bold font-[family-name:var(--font-display)] text-white mb-4 opacity-0 animate-slide-up animate-delay-100 leading-[1.05]">
        {L('services.title')}
      </h1>
    </div>
  </section>

  <!-- Services Detail -->
  <section class="section-padding">
    <div class="container-custom space-y-16">
      {servicesEntries.map((entry, i) => {
        const service = entry.data;
        return (
        <div class={`grid lg:grid-cols-2 gap-12 items-center`}>
          <div class="opacity-0 animate-slide-up" style={`animation-delay: ${i * 100}ms`}>
            <div class="w-16 h-16 bg-accent/10 flex items-center justify-center mb-6 text-accent [&_svg]:w-8 [&_svg]:h-8" set:html={service.icon} />
            <h2 class="text-4xl md:text-5xl font-bold font-[family-name:var(--font-display)] mb-4 leading-[1.05]">
              {service.title}
            </h2>
            <p class="text-muted leading-relaxed mb-6">
              {service.description}
            </p>
            <div class="flex flex-wrap gap-2 mb-6">
              {service.features?.map((feature: string) => (
                <span class="px-3 py-1 bg-secondary border-2 border-ink/10 text-sm font-medium text-muted">
                  {feature}
                </span>
              ))}
            </div>
            <a href={p(`/services/${entry.id}`)} class="btn-fire inline-flex items-center gap-2 group">
              {L('common.learnMore')}
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
          
          <div class="opacity-0 animate-slide-up animate-delay-200" style={`animation-delay: ${i * 100 + 100}ms`}>
            <div class="aspect-square max-w-md mx-auto bg-secondary border-2 border-ink/10 p-8 flex items-center justify-center">
              <svg viewBox="0 0 400 300" class="w-full" fill="none">
                {i === 0 && (
                  <>
                    <rect x="20" y="40" width="360" height="220" rx="15" fill="var(--color-surface)" stroke="var(--color-border)"/>
                    <rect x="60" y="80" width="120" height="80" rx="8" fill="var(--color-accent)" opacity="0.3"/>
                    <rect x="200" y="80" width="140" height="15" rx="4" fill="var(--color-accent)"/>
                    <rect x="200" y="110" width="100" height="10" rx="3" fill="var(--color-border)"/>
                    <rect x="200" y="135" width="120" height="10" rx="3" fill="var(--color-border)"/>
                    <rect x="60" y="190" width="280" height="40" rx="8" fill="var(--color-secondary)" stroke="var(--color-border)"/>
                  </>
                )}
                {i === 1 && (
                  <>
                    <rect x="50" y="50" width="140" height="200" rx="10" fill="var(--color-surface)" stroke="var(--color-border)"/>
                    <rect x="60" y="60" width="120" height="25" rx="5" fill="var(--color-accent)"/>
                    <rect x="60" y="100" width="80" height="15" rx="3" fill="var(--color-border)"/>
                    <rect x="60" y="130" width="120" height="15" rx="3" fill="var(--color-border)"/>
                    <rect x="60" y="160" width="90" height="15" rx="3" fill="var(--color-border)"/>
                    <rect x="60" y="190" width="110" height="15" rx="3" fill="var(--color-border)"/>
                    <rect x="210" y="50" width="140" height="200" rx="10" fill="var(--color-surface)" stroke="var(--color-border)"/>
                    <rect x="220" y="60" width="120" height="25" rx="5" fill="var(--color-accent)" opacity="0.5"/>
                    <rect x="220" y="100" width="80" height="15" rx="3" fill="var(--color-border)"/>
                    <rect x="220" y="130" width="120" height="15" rx="3" fill="var(--color-border)"/>
                    <rect x="220" y="160" width="90" height="15" rx="3" fill="var(--color-border)"/>
                    <rect x="220" y="190" width="110" height="15" rx="3" fill="var(--color-border)"/>
                  </>
                )}
                {i === 2 && (
                  <>
                    <rect x="80" y="40" width="90" height="180" rx="15" fill="var(--color-surface)" stroke="var(--color-border)"/>
                    <rect x="90" y="55" width="70" height="110" rx="8" fill="var(--color-secondary)"/>
                    <rect x="100" y="70" width="50" height="30" rx="4" fill="var(--color-accent)" opacity="0.5"/>
                    <rect x="100" y="110" width="50" height="8" rx="2" fill="var(--color-border)"/>
                    <rect x="100" y="130" width="40" height="8" rx="2" fill="var(--color-border)"/>
                    <rect x="230" y="40" width="90" height="180" rx="15" fill="var(--color-surface)" stroke="var(--color-border)"/>
                    <rect x="240" y="55" width="70" height="110" rx="8" fill="var(--color-secondary)"/>
                    <rect x="250" y="70" width="50" height="30" rx="4" fill="var(--color-accent)" opacity="0.3"/>
                    <rect x="250" y="110" width="50" height="8" rx="2" fill="var(--color-border)"/>
                    <rect x="250" y="130" width="40" height="8" rx="2" fill="var(--color-border)"/>
                  </>
                )}
                {i === 3 && (
                  <>
                    {/* Search bar */}
                    <rect x="40" y="50" width="240" height="36" rx="18" fill="var(--color-surface)" stroke="var(--color-border)"/>
                    <circle cx="62" cy="68" r="8" fill="none" stroke="var(--color-accent)" stroke-width="2"/>
                    <line x1="68" y1="74" x2="74" y2="80" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round"/>
                    <rect x="80" y="62" width="100" height="8" rx="4" fill="var(--color-border)" opacity="0.6"/>
                    {/* Ranking bars */}
                    <rect x="40" y="105" width="280" height="28" rx="6" fill="var(--color-surface)" stroke="var(--color-border)"/>
                    <rect x="52" y="113" width="12" height="12" rx="2" fill="var(--color-accent)" opacity="0.9"/>
                    <rect x="72" y="116" width="120" height="6" rx="3" fill="var(--color-accent)" opacity="0.5"/>
                    <rect x="200" y="116" width="60" height="6" rx="3" fill="var(--color-border)"/>
                    <rect x="40" y="143" width="280" height="28" rx="6" fill="var(--color-surface)" stroke="var(--color-border)"/>
                    <rect x="52" y="151" width="12" height="12" rx="2" fill="var(--color-border)"/>
                    <rect x="72" y="154" width="90" height="6" rx="3" fill="var(--color-border)" opacity="0.7"/>
                    <rect x="40" y="181" width="280" height="28" rx="6" fill="var(--color-surface)" stroke="var(--color-border)"/>
                    <rect x="52" y="189" width="12" height="12" rx="2" fill="var(--color-border)"/>
                    <rect x="72" y="192" width="110" height="6" rx="3" fill="var(--color-border)" opacity="0.5"/>
                    {/* Upward trend arrow */}
                    <polyline points="310,230 330,200 350,210 370,170" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <polygon points="370,160 376,174 364,174" fill="var(--color-accent)"/>
                  </>
                )}
              </svg>
            </div>
          </div>
        </div>
        );
      })}
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="py-12 bg-white border-y-2 border-ink/10">
    <div class="container-custom text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-ink/40 mb-6">{L('services.techSub')}</p>
      <TechnologyMarquee />
    </div>
  </section>

  <!-- Process -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="text-center mb-16">
        <span class="text-accent text-sm font-medium uppercase tracking-wider">{L('services.howWeWork')}</span>
        <h2 class="text-3xl md:text-4xl font-bold font-[family-name:var(--font-display)] mt-4">
          {L('services.process')}
        </h2>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {process.map((item, i) => (
          <div class="p-6 rounded-2xl bg-secondary border border-border hover:border-accent/30 transition-all duration-300 opacity-0 animate-slide-up" style={`animation-delay: ${i * 100}ms`}>
            <div class="text-4xl font-bold font-[family-name:var(--font-display)] text-accent/30 mb-4">
              {item.step}
            </div>
            <h3 class="text-lg font-semibold mb-2">{item.title}</h3>
            <p class="text-muted text-sm">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-ink relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[200px] bg-accent/10 rounded-full blur-3xl"></div>
      <div class="absolute top-0 right-1/3 w-[300px] h-[200px] bg-fire/10 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <h2 class="text-4xl md:text-6xl font-bold font-[family-name:var(--font-display)] mb-6 text-white leading-[1.05]">
        {L('services.readyToStart')}
      </h2>
      <p class="text-white/60 mb-8 max-w-xl mx-auto text-lg">
        {L('services.ctaDesc')}
      </p>
      <a href={p('/contact')} class="btn-fire inline-block">{L('common.getInTouch')}</a>
    </div>
  </section>

  <Footer />
</Layout>
