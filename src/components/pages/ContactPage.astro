---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import SocialIcons from '../../components/SocialIcons.astro';
import { business } from '../../data/business';
import { buildContactPage, siteUrl } from '../../lib/jsonld';


const contactDescription =
  "Get in touch with the ENET Systems team for a free consultation on web, mobile, and Odoo ERP projects.";
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "1x00000000000000000000AA";
---

<Layout
  title="Contact Us | ENET Systems LTD"
  description={contactDescription}
  jsonLd={buildContactPage({
    url: siteUrl('/contact'),
    description: contactDescription,
  })}
>
  <Navbar />

  <!-- Page Header — Bold ink hero -->
  <section class="pt-32 pb-16 relative overflow-hidden bg-ink">
    <div class="absolute inset-0">
      <div class="absolute inset-0 halftone halftone-light opacity-15" aria-hidden="true"></div>
      <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-fire/10 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <span class="badge mb-6 opacity-0 animate-slide-up" style="border: 2px solid var(--color-accent); color: var(--color-accent); background: rgba(40,175,162,0.1);">
        {'Get in touch with our team for a free consultation'}
      </span>
      <h1 class="text-6xl md:text-8xl font-bold font-[family-name:var(--font-display)] text-white mb-4 opacity-0 animate-slide-up animate-delay-100 leading-[1.05]">
        {'Contact Us'}
      </h1>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="grid lg:grid-cols-5 gap-12">
        <!-- Contact Info -->
        <div class="lg:col-span-2 opacity-0 animate-slide-up">
          <span class="badge badge-fire mb-4">{'Let\'s Connect'}</span>
          <h2 class="text-3xl md:text-4xl font-bold font-[family-name:var(--font-display)] mb-6 leading-[1.05]">
            {'Have a project in mind? We\'d love to hear from you. Send us a message and we\'ll respond as soon as possible.'}
          </h2>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-accent/10 border-2 border-accent/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <h4 class="font-bold mb-1">{'Phone'}</h4>
                <p class="text-muted text-sm">
                  <a href={business.telHref} class="hover:text-accent transition-colors font-medium">
                    {business.phoneDisplay}
                  </a>
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-fire/10 border-2 border-fire/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-fire" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h4 class="font-bold mb-1">{'Email'}</h4>
                <p class="text-muted text-sm">
                  <a href={business.mailtoHref} class="hover:text-fire transition-colors font-medium">
                    {business.emailDisplay}
                  </a>
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-accent/10 border-2 border-accent/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h4 class="font-bold mb-1">{'Working Hours'}</h4>
                <p class="text-muted text-sm font-medium">{business.workingHours}</p>
              </div>
            </div>

            <div class="pt-2">
              <p class="text-sm font-bold mb-3 font-[family-name:var(--font-display)] uppercase tracking-wider">
                {'Social'}
              </p>
              <SocialIcons />
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-3 opacity-0 animate-slide-up animate-delay-200">
          <form
            class="bg-white border-2 border-ink/10 p-8"
            id="contact-form"
            action="/contact.php"
            method="POST"
            novalidate
          >
            <h3 class="text-2xl font-bold font-[family-name:var(--font-display)] mb-6">
              {'Send Us a Message'}
            </h3>

            <div class="grid md:grid-cols-2 gap-6 mb-6">
              <div>
                <label class="block text-sm font-bold mb-2" for="name">{'Full Name *'}</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  maxlength="200"
                  autocomplete="name"
                  class="w-full px-4 py-3 bg-secondary border-2 border-ink/10 focus:border-accent focus:outline-none transition-colors"
                  placeholder="Your name"
                />
              </div>
              <div>
                <label class="block text-sm font-bold mb-2" for="email">{'Email Address *'}</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  maxlength="200"
                  autocomplete="email"
                  class="w-full px-4 py-3 bg-secondary border-2 border-ink/10 focus:border-accent focus:outline-none transition-colors"
                  placeholder="your@email.com"
                />
              </div>
            </div>

            <div class="grid md:grid-cols-2 gap-6 mb-6">
              <div>
                <label class="block text-sm font-bold mb-2" for="phone">{'Phone Number'}</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  maxlength="50"
                  autocomplete="tel"
                  class="w-full px-4 py-3 bg-secondary border-2 border-ink/10 focus:border-accent focus:outline-none transition-colors"
                  placeholder="+20 XXX XXX XXXX"
                />
              </div>
              <div>
                <label class="block text-sm font-bold mb-2" for="service">{'Service Interested In'}</label>
                <select
                  id="service"
                  name="service"
                  class="w-full px-4 py-3 bg-secondary border-2 border-ink/10 focus:border-accent focus:outline-none transition-colors"
                >
                  <option value="">{'Select a service'}</option>
                  <option value="web">{'Web Development'}</option>
                  <option value="odoo">{'Odoo ERP'}</option>
                  <option value="mobile">{'Mobile Apps'}</option>
                  <option value="agentic">{'Agentic Automation'}</option>
                  <option value="other">{'Other'}</option>
                </select>
              </div>
            </div>

            <div class="mb-6">
              <label class="block text-sm font-bold mb-2" for="message">{'Message *'}</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                maxlength="5000"
                class="w-full px-4 py-3 bg-secondary border-2 border-ink/10 focus:border-accent focus:outline-none transition-colors resize-none"
                placeholder="Tell us about your project..."
              ></textarea>
            </div>

            <div class="mb-6">
              <div
                id="cf-turnstile"
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-theme="light"
              ></div>
            </div>

            <p
              id="contact-form-status"
              class="mb-4 text-sm font-medium min-h-5"
              role="status"
              aria-live="polite"
            ></p>

            <button type="submit" id="contact-submit" class="btn-fire w-full">
              {'Send Message'}
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  declare global {
    interface Window {
      turnstile?: {
        render: (container: string | HTMLElement, options: Record<string, unknown>) => string;
        reset: (widgetId?: string) => void;
        remove: (widgetId: string) => void;
      };
    }
  }

  const TURNSTILE_SRC = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";

  let widgetId: string | undefined;
  let boundForm: HTMLFormElement | null = null;

  function statusEl() {
    return document.getElementById("contact-form-status");
  }

  function setStatus(message: string, kind: "idle" | "error" | "success") {
    const el = statusEl();
    if (!el) return;
    el.textContent = message;
    el.classList.remove("text-fire", "text-accent", "text-muted");
    if (kind === "error") el.classList.add("text-fire");
    if (kind === "success") el.classList.add("text-accent");
    if (kind === "idle") el.classList.add("text-muted");
  }

  function loadTurnstile(): Promise<NonNullable<Window["turnstile"]>> {
    if (window.turnstile) return Promise.resolve(window.turnstile);

    return new Promise((resolve, reject) => {
      const existing = document.querySelector<HTMLScriptElement>(
        `script[src="${TURNSTILE_SRC}"]`,
      );
      const onReady = () => {
        if (window.turnstile) resolve(window.turnstile);
        else reject(new Error("Turnstile failed to load"));
      };

      if (existing) {
        if (window.turnstile) onReady();
        else existing.addEventListener("load", onReady, { once: true });
        existing.addEventListener("error", () => reject(new Error("Turnstile failed to load")), {
          once: true,
        });
        return;
      }

      const script = document.createElement("script");
      script.src = TURNSTILE_SRC;
      script.async = true;
      script.onload = onReady;
      script.onerror = () => reject(new Error("Turnstile failed to load"));
      document.head.appendChild(script);
    });
  }

  async function renderWidget() {
    const container = document.getElementById("cf-turnstile");
    if (!container) return;

    const sitekey = container.getAttribute("data-sitekey");
    if (!sitekey) return;

    const turnstile = await loadTurnstile();
    if (widgetId) {
      try {
        turnstile.remove(widgetId);
      } catch {
        // Widget may already be gone after a client-side navigation.
      }
      widgetId = undefined;
    }
    container.innerHTML = "";
    widgetId = turnstile.render(container, {
      sitekey,
      theme: "light",
    });
  }

  async function onSubmit(event: Event) {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const submit = document.getElementById("contact-submit") as HTMLButtonElement | null;
    const tokenInput = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (!tokenInput?.value) {
      setStatus("Please complete the verification challenge.", "error");
      return;
    }

    setStatus("Sending…", "idle");
    if (submit) submit.disabled = true;

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const data = (await response.json()) as { ok?: boolean; error?: string };

      if (!response.ok || !data.ok) {
        setStatus(data.error || "Could not send your message. Please try again.", "error");
        window.turnstile?.reset(widgetId);
        return;
      }

      form.reset();
      window.turnstile?.reset(widgetId);
      setStatus("Thank you. We will get back to you soon.", "success");
    } catch {
      setStatus("Could not send your message. Please try again.", "error");
      window.turnstile?.reset(widgetId);
    } finally {
      if (submit) submit.disabled = false;
    }
  }

  async function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    if (!form) return;

    if (boundForm && boundForm !== form) {
      boundForm.removeEventListener("submit", onSubmit);
    }
    if (boundForm !== form) {
      form.addEventListener("submit", onSubmit);
      boundForm = form;
    }

    try {
      await renderWidget();
    } catch {
      setStatus("Verification failed to load. Refresh the page and try again.", "error");
    }
  }

  document.addEventListener("astro:page-load", () => {
    void initContactForm();
  });
</script>
