---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import SocialIcons from '../../components/SocialIcons.astro';
import { business } from '../../data/business';
import { buildContactPage, siteUrl } from '../../lib/jsonld';
import { t, type Locale } from '../../i18n/i18n';

const { locale } = Astro.props as { locale: Locale };
const L = (k: Parameters<typeof t>[1]) => t(locale, k);
const p = (path: string) => `/${locale}${path === "/" ? "" : path}`;

const contactDescription =
  "Get in touch with the ENET Systems team for a free consultation on web, mobile, and Odoo ERP projects.";
const contactDescriptionAr =
  'تواصل مع فريق ENET Systems للحصول على استشارة مجانية حول مشاريع الويب والجوال وأودو ERP.';
const contactSeo = locale === 'ar' ? contactDescriptionAr : contactDescription;
---

<Layout
  title={locale === 'ar' ? 'تواصل معنا | ENET Systems' : 'Contact Us | ENET Systems LTD'}
  description={contactSeo}
  jsonLd={buildContactPage({
    url: siteUrl(p('/contact')),
    description: contactSeo,
  })}
>
  <Navbar />

  <!-- Page Header — Bold ink hero -->
  <section class="pt-32 pb-16 relative overflow-hidden bg-ink">
    <div class="absolute inset-0">
      <div class="absolute inset-0 halftone halftone-light opacity-15" aria-hidden="true"></div>
      <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-fire/10 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <span class="badge mb-6 opacity-0 animate-slide-up" style="border: 2px solid var(--color-accent); color: var(--color-accent); background: rgba(40,175,162,0.1);">
        {L('contact.subtitle')}
      </span>
      <h1 class="text-6xl md:text-8xl font-bold font-[family-name:var(--font-display)] text-white mb-4 opacity-0 animate-slide-up animate-delay-100 leading-[1.05]">
        {L('contact.title')}
      </h1>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="grid lg:grid-cols-5 gap-12">
        <!-- Contact Info -->
        <div class="lg:col-span-2 opacity-0 animate-slide-up">
          <span class="badge badge-fire mb-4">{L('contact.letsConnect')}</span>
          <h2 class="text-3xl md:text-4xl font-bold font-[family-name:var(--font-display)] mb-6 leading-[1.05]">
            {L('contact.desc')}
          </h2>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-accent/10 border-2 border-accent/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <h4 class="font-bold mb-1">{L('contact.phone')}</h4>
                <p class="text-muted text-sm">
                  <a href={business.telHref} class="hover:text-accent transition-colors font-medium">
                    {business.phoneDisplay}
                  </a>
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-fire/10 border-2 border-fire/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-fire" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h4 class="font-bold mb-1">{L('contact.email')}</h4>
                <p class="text-muted text-sm">
                  <a href={business.mailtoHref} class="hover:text-fire transition-colors font-medium">
                    {business.emailDisplay}
                  </a>
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-accent/10 border-2 border-accent/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h4 class="font-bold mb-1">{L('contact.workingHours')}</h4>
                <p class="text-muted text-sm font-medium">{business.workingHours}</p>
              </div>
            </div>

            <div class="pt-2">
              <p class="text-sm font-bold mb-3 font-[family-name:var(--font-display)] uppercase tracking-wider">
                {L('contact.social')}
              </p>
              <SocialIcons />
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-3 opacity-0 animate-slide-up animate-delay-200">
          <form class="bg-white border-2 border-ink/10 p-8" id="contact-form">
            <h3 class="text-2xl font-bold font-[family-name:var(--font-display)] mb-6">
              {L('contact.sendUsMessage')}
            </h3>

            <div class="grid md:grid-cols-2 gap-6 mb-6">
              <div>
                <label class="block text-sm font-bold mb-2" for="name">{L('contact.fullName')}</label>
                <input
                  type="text"
                  id="name"
                  required
                  class="w-full px-4 py-3 bg-secondary border-2 border-ink/10 focus:border-accent focus:outline-none transition-colors"
                  placeholder={locale === 'ar' ? 'اسمك' : 'Your name'}
                />
              </div>
              <div>
                <label class="block text-sm font-bold mb-2" for="email">{L('contact.emailAddress')}</label>
                <input
                  type="email"
                  id="email"
                  required
                  class="w-full px-4 py-3 bg-secondary border-2 border-ink/10 focus:border-accent focus:outline-none transition-colors"
                  placeholder="your@email.com"
                />
              </div>
            </div>

            <div class="grid md:grid-cols-2 gap-6 mb-6">
              <div>
                <label class="block text-sm font-bold mb-2" for="phone">{L('contact.phoneNumber')}</label>
                <input
                  type="tel"
                  id="phone"
                  class="w-full px-4 py-3 bg-secondary border-2 border-ink/10 focus:border-accent focus:outline-none transition-colors"
                  placeholder="+20 XXX XXX XXXX"
                />
              </div>
              <div>
                <label class="block text-sm font-bold mb-2" for="service">{L('contact.serviceInterested')}</label>
                <select
                  id="service"
                  class="w-full px-4 py-3 bg-secondary border-2 border-ink/10 focus:border-accent focus:outline-none transition-colors"
                >
                  <option value="">{L('contact.selectService')}</option>
                  <option value="web">{L('contact.opt.web')}</option>
                  <option value="odoo">{L('contact.opt.odoo')}</option>
                  <option value="mobile">{L('contact.opt.mobile')}</option>
                  <option value="other">{L('contact.opt.other')}</option>
                </select>
              </div>
            </div>

            <div class="mb-6">
              <label class="block text-sm font-bold mb-2" for="message">{L('contact.message')}</label>
              <textarea
                id="message"
                required
                rows="5"
                class="w-full px-4 py-3 bg-secondary border-2 border-ink/10 focus:border-accent focus:outline-none transition-colors resize-none"
                placeholder={locale === 'ar' ? 'حدثنا عن مشروعك...' : 'Tell us about your project...'}
              ></textarea>
            </div>

            <button type="submit" class="btn-fire w-full">
              {L('contact.sendMessage')}
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Thank you for your message! We will get back to you soon.');
    (e.target as HTMLFormElement).reset();
  });
</script>
