---
import { EnetLogo } from "./EnetLogo";
import SocialIcons from "./SocialIcons.astro";

const currentYear = new Date().getFullYear();
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "") + "/";
---

<footer class="bg-linear-to-b from-transparent to-secondary">
  <EnetLogo
    className="w-90 mx-auto mt-12 h-auto object-contain -mb-8"
    primaryColor="#ffffff"
  />
  <p
    class="text-accent text-lg leading-relaxed text-center px-4 max-w-2xl mx-auto font-heading font-bold tracking-wide text-shadow-accent/20 select-none animate-pulse
    text-shadow-lg"
  >
    Growth through technology.
  </p>
  <div class="container-custom py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
      <div>
        <h4
          class="text-white font-semibold mb-4 font-[family-name:var(--font-display)]"
        >
          Quick Links
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href={base || "/"}
              class="text-muted text-sm hover:text-accent transition-colors"
              >Home</a
            >
          </li>
          <li>
            <a
              href={`${base}about`}
              class="text-muted text-sm hover:text-accent transition-colors"
              >About</a
            >
          </li>
          <li>
            <a
              href={`${base}services`}
              class="text-muted text-sm hover:text-accent transition-colors"
              >Services</a
            >
          </li>
          <li>
            <a
              href={`${base}portfolio`}
              class="text-muted text-sm hover:text-accent transition-colors"
              >Portfolio</a
            >
          </li>
          <li>
            <a
              href={`${base}contact`}
              class="text-muted text-sm hover:text-accent transition-colors"
              >Contact</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4
          class="text-white font-semibold mb-4 font-[family-name:var(--font-display)]"
        >
          Services
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href={`${base}services`}
              class="text-muted text-sm hover:text-accent transition-colors"
              >Web Development</a
            >
          </li>
          <li>
            <a
              href={`${base}services`}
              class="text-muted text-sm hover:text-accent transition-colors"
              >Odoo ERP</a
            >
          </li>
          <li>
            <a
              href={`${base}services`}
              class="text-muted text-sm hover:text-accent transition-colors"
              >Mobile Apps</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4
          class="text-white font-semibold mb-4 font-[family-name:var(--font-display)]"
        >
          Contact
        </h4>
        <ul class="space-y-3 text-muted text-sm">
          <li>+20 127 6666 314</li>
          <li>Inquiry@enet.systems</li>
        </ul>
        <p class="text-white font-semibold mt-6 mb-3 text-sm font-[family-name:var(--font-display)]">
          Follow us
        </p>
        <SocialIcons />
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-border text-center">
      <p class="text-muted text-sm">
        © {currentYear} ENET SYSTEMS LTD - All rights reserved.
      </p>
    </div>
  </div>
</footer>
