<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 640 360"
  fill="none"
  role="presentation"
  aria-hidden="true"
  class="h-full w-full"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
>
  <rect width="640" height="360" fill="#f4f4f5" />

  <g class="ops-guides" stroke="#0a0a12">
    <line x1="0" y1="48" x2="640" y2="48" />
    <line x1="0" y1="312" x2="640" y2="312" />
    <line x1="48" y1="0" x2="48" y2="360" />
    <line x1="592" y1="0" x2="592" y2="360" />
    <line x1="268" y1="48" x2="268" y2="312" />
    <rect x="48" y="48" width="544" height="264" />
  </g>

  <g class="ops-link-a" stroke="#28AFA2">
    <line x1="156" y1="92" x2="336" y2="118" />
  </g>
  <g class="ops-link-b" stroke="#28AFA2">
    <line x1="210" y1="178" x2="336" y2="180" />
  </g>
  <g class="ops-link-c" stroke="#28AFA2">
    <line x1="152" y1="272" x2="336" y2="242" />
  </g>

  <rect class="ops-dot-a" x="154" y="90" width="4" height="4" fill="#28AFA2" stroke="none" />
  <rect class="ops-dot-b" x="208" y="176" width="4" height="4" fill="#28AFA2" stroke="none" />
  <rect class="ops-dot-c" x="150" y="270" width="4" height="4" fill="#28AFA2" stroke="none" />
  <rect class="ops-dot-a2" x="154" y="90" width="4" height="4" fill="#0a0a12" stroke="none" />
  <rect class="ops-dot-b2" x="208" y="176" width="4" height="4" fill="#0a0a12" stroke="none" />
  <rect class="ops-dot-c2" x="150" y="270" width="4" height="4" fill="#FF6B35" stroke="none" />

  <g class="ops-panel-a">
    <rect x="64" y="64" width="92" height="56" fill="#ffffff" stroke="#0a0a12" />
    <rect x="74" y="74" width="18" height="3" fill="#0a0a12" stroke="none" />
    <rect x="96" y="74" width="10" height="3" fill="#71717a" stroke="none" />
    <rect x="80" y="92" width="8" height="8" stroke="#71717a" />
    <rect x="94" y="92" width="8" height="8" stroke="#71717a" />
    <rect x="108" y="92" width="8" height="8" stroke="#71717a" />
    <rect x="80" y="106" width="8" height="8" stroke="#71717a" />
    <rect x="94" y="106" width="8" height="8" stroke="#28AFA2" />
    <rect x="108" y="106" width="8" height="8" stroke="#71717a" />
  </g>

  <g class="ops-panel-b">
    <rect x="118" y="150" width="92" height="56" fill="#ffffff" stroke="#0a0a12" />
    <rect x="128" y="160" width="22" height="3" fill="#0a0a12" stroke="none" />
    <rect x="154" y="160" width="8" height="3" fill="#FF6B35" stroke="none" />
    <polyline
      points="132,192 144,184 156,188 168,176 180,182 192,170"
      stroke="#71717a"
    />
    <rect x="196" y="154" width="6" height="6" fill="#FF6B35" stroke="none" />
  </g>

  <g class="ops-panel-c">
    <rect x="52" y="246" width="100" height="52" fill="#ffffff" stroke="#0a0a12" />
    <rect x="62" y="256" width="14" height="3" fill="#0a0a12" stroke="none" />
    <rect x="80" y="256" width="16" height="3" fill="#71717a" stroke="none" />
    <rect x="68" y="272" width="3" height="16" fill="#71717a" stroke="none" />
    <rect x="80" y="268" width="3" height="20" fill="#71717a" stroke="none" />
    <rect x="92" y="274" width="3" height="14" fill="#0a0a12" stroke="none" />
    <rect x="104" y="266" width="3" height="22" fill="#71717a" stroke="none" />
    <rect x="116" y="270" width="3" height="18" fill="#71717a" stroke="none" />
  </g>

  <g class="ops-system">
    <rect x="336" y="64" width="248" height="232" fill="#ffffff" stroke="#0a0a12" />
    <rect x="356" y="84" width="64" height="192" stroke="#0a0a12" />
    <rect x="428" y="84" width="64" height="192" stroke="#0a0a12" />
    <rect x="500" y="84" width="64" height="192" stroke="#0a0a12" />
    <line class="ops-spine" x1="356" y1="180" x2="564" y2="180" stroke="#28AFA2" />
    <rect x="372" y="100" width="16" height="3" fill="#0a0a12" stroke="none" />
    <rect x="392" y="100" width="8" height="3" fill="#71717a" stroke="none" />
    <rect x="444" y="100" width="16" height="3" fill="#0a0a12" stroke="none" />
    <rect x="464" y="100" width="8" height="3" fill="#71717a" stroke="none" />
    <rect x="516" y="100" width="16" height="3" fill="#0a0a12" stroke="none" />
    <rect x="536" y="100" width="8" height="3" fill="#71717a" stroke="none" />
    <rect x="372" y="124" width="32" height="32" stroke="#71717a" />
    <rect x="444" y="124" width="32" height="32" stroke="#71717a" />
    <rect x="516" y="124" width="32" height="32" stroke="#71717a" />
    <line x1="372" y1="220" x2="404" y2="220" stroke="#71717a" />
    <line x1="444" y1="220" x2="476" y2="220" stroke="#71717a" />
    <line x1="516" y1="220" x2="548" y2="220" stroke="#71717a" />
    <rect class="ops-hub" x="332" y="176" width="8" height="8" fill="#28AFA2" stroke="none" />
    <path d="M336 80 h12 M336 80 v12" stroke="#28AFA2" />
    <path d="M584 80 h-12 M584 80 v12" stroke="#28AFA2" />
    <path d="M336 280 h12 M336 280 v-12" stroke="#28AFA2" />
    <path d="M584 280 h-12 M584 280 v-12" stroke="#28AFA2" />
  </g>
</svg>

<style>
  .ops-guides {
    opacity: 0.07;
  }

  .ops-panel-a,
  .ops-panel-b,
  .ops-panel-c,
  .ops-link-a,
  .ops-link-b,
  .ops-link-c,
  .ops-dot-a,
  .ops-dot-b,
  .ops-dot-c,
  .ops-dot-a2,
  .ops-dot-b2,
  .ops-dot-c2,
  .ops-system,
  .ops-hub,
  .ops-spine {
    transform-box: view-box;
  }

  .ops-panel-a,
  .ops-panel-b,
  .ops-panel-c,
  .ops-dot-a,
  .ops-dot-b,
  .ops-dot-c,
  .ops-dot-a2,
  .ops-dot-b2,
  .ops-dot-c2,
  .ops-system {
    transform-origin: 0 0;
  }

  .ops-link-a {
    transform-origin: 24.375% 25.556%;
    animation: ops-draw 10s ease-in-out infinite;
  }

  .ops-link-b {
    transform-origin: 32.813% 49.444%;
    animation: ops-draw 10s ease-in-out 0.8s infinite;
  }

  .ops-link-c {
    transform-origin: 23.75% 75.556%;
    animation: ops-draw 10s ease-in-out 1.6s infinite;
  }

  .ops-panel-a {
    animation: ops-drift-a 11s ease-in-out infinite;
  }

  .ops-panel-b {
    animation: ops-drift-b 9s ease-in-out 0.4s infinite;
  }

  .ops-panel-c {
    animation: ops-drift-c 12s ease-in-out 1.1s infinite;
  }

  .ops-dot-a {
    animation: ops-travel-a 10s linear infinite;
  }

  .ops-dot-b {
    animation: ops-travel-b 9s linear 1.2s infinite;
  }

  .ops-dot-c {
    animation: ops-travel-c 11s linear 0.6s infinite;
  }

  .ops-dot-a2 {
    animation: ops-travel-a 10s linear 5s infinite;
  }

  .ops-dot-b2 {
    animation: ops-travel-b 9s linear 5.6s infinite;
  }

  .ops-dot-c2 {
    animation: ops-travel-c 11s linear 6.1s infinite;
  }

  .ops-system {
    animation: ops-settle 12s ease-in-out infinite;
  }

  .ops-hub {
    transform-origin: 52.5% 50%;
    animation: ops-hub-pulse 8s ease-in-out infinite;
  }

  .ops-spine {
    transform-origin: 50% 50%;
    animation: ops-spine-pulse 8s ease-in-out 0.5s infinite;
  }

  @keyframes ops-drift-a {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(1.1%, -1.9%);
    }
  }

  @keyframes ops-drift-b {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-0.9%, 1.4%);
    }
  }

  @keyframes ops-drift-c {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(1.3%, 1.1%);
    }
  }

  @keyframes ops-draw {
    0% {
      opacity: 0.15;
      transform: scale(0.12);
    }
    22% {
      opacity: 1;
      transform: scale(1);
    }
    72% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0.35;
      transform: scale(1);
    }
  }

  @keyframes ops-travel-a {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    8% {
      opacity: 1;
    }
    82% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(28.125%, 7.222%);
    }
  }

  @keyframes ops-travel-b {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    8% {
      opacity: 1;
    }
    82% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(19.688%, 0.556%);
    }
  }

  @keyframes ops-travel-c {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    8% {
      opacity: 1;
    }
    82% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(28.75%, -8.333%);
    }
  }

  @keyframes ops-settle {
    0%,
    100% {
      opacity: 1;
      transform: translate(0, 0);
    }
    50% {
      opacity: 1;
      transform: translate(0.3%, 0);
    }
  }

  @keyframes ops-hub-pulse {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.25);
    }
  }

  @keyframes ops-spine-pulse {
    0%,
    100% {
      opacity: 0.4;
    }
    40% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    svg :is(g, rect, line, path, circle, polyline) {
      animation: none !important;
    }
  }
</style>
