---
import SocialIcons from "./SocialIcons.astro";
import { getServices } from "../lib/collections";

const currentPath = Astro.url.pathname;
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "") + "/";


type NavItem = { href: string; label: string };
type NavLink = NavItem & { items?: NavItem[]; cta?: boolean };

const serviceEntries = await getServices();
const serviceItems: NavItem[] = serviceEntries.map((entry) => ({
  href: `/services/${entry.id}`,
  label: entry.data.title,
}));

const navLinks: NavLink[] = [
  { href: "/", label: 'Home' },
  { href: "/about", label: 'About' },
  { href: "/case-studies", label: 'Case Studies' },
  {
    href: "/services",
    label: 'Services',
    items: serviceItems,
  },
  { href: "/blog", label: 'Blog' },
  { href: "/contact", label: 'Get started', cta: true },
];

const norm = (s: string) => s.replace(/\/+$/, "") || "/";

const isActive = (href: string) => {
  if (href === base || href === "/") {
    return (
      currentPath === "/" || currentPath === base || currentPath === `${base}/`
    );
  }
  return currentPath.startsWith(href);
};

const isLinkActive = (link: NavLink) => {
  if (isActive(link.href)) return true;
  return link.items?.some((item) => isActive(item.href)) ?? false;
};

const nonCtaLinks = navLinks.filter((l) => !l.cta);
const ctaLink = navLinks.find((l) => l.cta);
---

<!-- CSS-driven toggle: this checkbox IS the open/closed state -->
<input type="checkbox" id="nav-toggle" class="peer sr-only" />

<!-- ── Desktop + mobile top bar ───────────────────────────────────────── -->
<nav
  id="site-nav"
  class="sticky top-0 z-50 border-b-2 border-ink/10 bg-primary/90 backdrop-blur-xl"
  aria-label="Main"
>
  <!-- Dual accent bar at very top -->
  <div class="flex h-1 w-full">
    <div class="flex-1 bg-accent"></div>
    <div class="flex-1 bg-fire"></div>
  </div>

  <div class="container-custom">
    <div class="flex h-16 items-center justify-between md:h-20">
      <a href={"/"} class="flex h-12 items-center md:h-16">
        <img src="/logo-dark.svg" alt="ENET Systems LTD" class="h-12 py-2 md:h-16" />
      </a>

      <!-- Desktop nav -->
      <div class="hidden items-center gap-1 md:flex md:gap-2">
        {
          navLinks.map((link) =>
            link.cta ? (
              <a
                href={link.href}
                class:list={[
                  "btn-fire ml-2 shrink-0 text-sm md:ml-3",
                  isActive(link.href) &&
                    "ring-2 ring-ink/15 ring-offset-2 ring-offset-primary",
                ]}
              >
                {link.label}
              </a>
            ) : link.items ? (
              <details class="group relative">
                <summary
                  class:list={[
                    "flex cursor-pointer list-none items-center gap-1 border-2 border-transparent px-3 py-2 text-sm font-bold transition-all hover:border-ink/15 [&::-webkit-details-marker]:hidden",
                    isLinkActive(link) ? "text-accent border-accent/20 bg-accent/5" : "text-muted",
                  ]}
                >
                  <span>{link.label}</span>
                  <svg
                    class="inline-block size-4 shrink-0 text-muted transition-transform duration-200 group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2.5"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>
                <div
                  class="absolute left-0 top-full z-50 min-w-56 pt-2"
                  role="presentation"
                >
                  <div class="border-2 border-ink/10 bg-white py-2 shadow-2xl shadow-ink/10">
                    <a
                      href={link.href}
                      class:list={[
                        "block px-4 py-2.5 text-sm font-bold transition-colors hover:bg-accent/5 hover:text-accent border-l-2 border-transparent hover:border-accent",
                        isActive(link.href) &&
                          !link.items.some((i) => isActive(i.href))
                          ? "text-accent border-accent bg-accent/5"
                          : "text-muted",
                      ]}
                    >
                      All services
                    </a>
                    <div class="my-1 h-px bg-border" role="separator" />
                    {link.items.map((item) => (
                      <a
                        href={item.href}
                        class:list={[
                          "block px-4 py-2.5 text-sm font-bold transition-colors hover:bg-fire/5 hover:text-fire border-l-2 border-transparent hover:border-fire",
                          isActive(item.href) ? "text-fire border-fire bg-fire/5" : "text-muted",
                        ]}
                      >
                        {item.label}
                      </a>
                    ))}
                  </div>
                </div>
              </details>
            ) : (
              <a
                href={link.href}
                class:list={[
                  "border-2 border-transparent px-3 py-2 text-sm font-bold transition-all hover:border-ink/15",
                  isActive(link.href) ? "text-accent border-accent/20 bg-accent/5" : "text-muted",
                ]}
              >
                {link.label}
              </a>
            ),
          )
        }
      </div>

      <!-- Hamburger label — the CSS toggle trigger -->
      <label
        for="nav-toggle"
        class="relative z-[80] flex h-11 w-11 cursor-pointer touch-manipulation flex-col items-center justify-center gap-[5px] border-2 border-ink/15 text-ink md:hidden"
        aria-label={'Toggle menu'}
      >
        <span class="ham-bar ham-bar-1 block h-[2px] w-6 origin-center bg-current transition-all duration-300 ease-out" />
        <span class="ham-bar ham-bar-2 block h-[2px] w-6 rounded-full bg-current transition-all duration-300 ease-out" />
        <span class="ham-bar ham-bar-3 block h-[2px] w-6 origin-center rounded-full bg-current transition-all duration-300 ease-out" />
      </label>
    </div>
  </div>
</nav>

<!-- ── Full-screen mobile menu ─────────────────────────────────────────── -->
<div
  id="mobile-panel"
  class="fixed inset-0 z-[70] flex flex-col bg-ink transition-transform duration-300 ease-in-out translate-x-full peer-checked:translate-x-0 md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
>
  <!-- Decorative dual-tone accent blobs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-accent/15 blur-3xl"></div>
    <div class="absolute bottom-0 -left-16 w-64 h-64 rounded-full bg-fire/10 blur-3xl"></div>
  </div>

  <!-- Top bar: logo + close button -->
  <div class="relative flex h-16 shrink-0 items-center justify-between px-6 border-b border-white/10">
    <a href={"/"} class="flex h-10 items-center">
      <img src="/logo-small.svg" alt="ENET Systems LTD" class="h-12 py-2 md:h-16" />
    </a>
    <label
      for="nav-toggle"
      class="flex h-11 w-11 cursor-pointer items-center justify-center border-2 border-white/20 text-white/80 transition-colors hover:text-white hover:border-white/40"
      aria-label={'Close menu'}
    >
      <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </label>
  </div>

  <!-- Links — scrollable, takes up remaining space -->
  <div class="relative flex-1 overflow-y-auto overscroll-contain px-6 py-8">
    <ul class="flex flex-col gap-1">
      {
        nonCtaLinks.map((link) =>
          link.items ? (
            <li>
              <details class="group/ms">
                <summary class:list={[
                  "flex cursor-pointer list-none items-center justify-between py-4 text-4xl font-bold font-[family-name:var(--font-display)] tracking-tight transition-colors [&::-webkit-details-marker]:hidden hover:text-accent text-white",
                  isLinkActive(link) && "text-accent",
                ]}>
                  <span>{link.label}</span>
                  <svg
                    class="size-7 shrink-0 text-white/50 transition-transform duration-200 group-open/ms:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>

                <!-- Sub-links -->
                <ul class="mt-1 mb-3 flex flex-col border-l-2 border-accent/30 pl-5 gap-0">
                  <li>
                    <a
                      href={link.href}
                      class:list={[
                        "flex items-center py-3 text-lg font-bold transition-colors hover:text-accent",
                        isActive(link.href) && !link.items.some((i) => isActive(i.href))
                          ? "text-accent"
                          : "text-white/60",
                      ]}
                    >
                      All services
                    </a>
                  </li>
                  {link.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class:list={[
                          "flex items-center py-3 text-lg font-bold transition-colors hover:text-fire",
                          isActive(item.href) ? "text-fire" : "text-white/60",
                        ]}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a
                href={link.href}
                class:list={[
                  "flex items-center py-4 text-4xl font-bold font-[family-name:var(--font-display)] tracking-tight transition-colors hover:text-accent",
                  isActive(link.href) ? "text-accent" : "text-white",
                ]}
              >
                {link.label}
              </a>
            </li>
          ),
        )
      }
    </ul>
  </div>

  <!-- Bottom: CTA + social -->
  <div class="relative shrink-0 border-t border-white/10 px-6 pb-[max(1.5rem,env(safe-area-inset-bottom))] pt-6 space-y-5">
    {
      ctaLink && (
        <a
          href={ctaLink.href}
          class="btn-fire flex min-h-[3.25rem] w-full items-center justify-center text-base font-bold"
        >
          {ctaLink.label}
        </a>
      )
    }
    <div class="flex items-center justify-between">
      <p class="text-[13px] font-bold text-white/50 uppercase tracking-widest">{'Connect'}</p>
      <SocialIcons size="sm" />
    </div>
  </div>
</div>

<style>
  /* Hamburger → X when checkbox is checked */
  #nav-toggle:checked ~ nav .ham-bar-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #nav-toggle:checked ~ nav .ham-bar-2 {
    opacity: 0;
    transform: scaleX(0);
  }
  #nav-toggle:checked ~ nav .ham-bar-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  body.menu-open {
    overflow: hidden;
  }
</style>

<script>
  function initNav() {
    const toggle = document.getElementById("nav-toggle") as HTMLInputElement | null;

    if (!toggle) return;

    toggle.checked = false;
    document.body.classList.remove("menu-open");

    toggle.addEventListener("change", () => {
      document.body.classList.toggle("menu-open", toggle.checked);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.checked) {
        toggle.checked = false;
        document.body.classList.remove("menu-open");
      }
    });

    document.querySelectorAll("#mobile-panel a").forEach((el) => {
      el.addEventListener("click", () => {
        toggle.checked = false;
        document.body.classList.remove("menu-open");
      });
    });

    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      document.querySelectorAll("#site-nav details").forEach((d) => {
        if (!d.contains(target)) (d as HTMLDetailsElement).open = false;
      });
    });
  }

  document.addEventListener("astro:page-load", initNav);
</script>
