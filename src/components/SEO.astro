---
import { business } from "../data/business";
import { ORGANIZATION_ID, WEBSITE_ID, type JsonLdObject } from "../lib/jsonld";

interface Props {
  description: string;
  jsonLd?: JsonLdObject | JsonLdObject[];
}

const { description, jsonLd } = Astro.props;

const orgUrl = business.publicSiteUrl;
const logoUrl = `${orgUrl}${business.logoPath}`;

const organizationSchema: JsonLdObject = {
  "@context": "https://schema.org",
  "@id": ORGANIZATION_ID,
  "@type": "Organization",
  name: business.legalName,
  url: orgUrl,
  logo: logoUrl,
  email: business.email,
  telephone: business.phoneE164,
  description: business.organizationDescription,
  address: {
    "@type": "PostalAddress",
    addressCountry: business.address.addressCountry,
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    telephone: business.phoneE164,
    email: business.email,
    areaServed: business.areaServed,
    availableLanguage: [...business.availableLanguages],
  },
};

const websiteSchema: JsonLdObject = {
  "@context": "https://schema.org",
  "@id": WEBSITE_ID,
  "@type": "WebSite",
  name: business.shortName,
  url: orgUrl,
  description: description,
  publisher: { "@id": ORGANIZATION_ID },
};

const extraJsonLd: JsonLdObject[] = !jsonLd
  ? []
  : Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd];
---

<!-- JSON-LD Structured Data -->
<script
  type="application/ld+json"
  set:html={JSON.stringify(organizationSchema)}
/>
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
{extraJsonLd.map((obj) => (
  <script type="application/ld+json" set:html={JSON.stringify(obj)} />
))}
