---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import { ClientRouter } from "astro:transitions";
import type { JsonLdObject } from '../lib/jsonld';
import { business } from '../data/business';

interface Props {
  title: string;
  description?: string;
  jsonLd?: JsonLdObject | JsonLdObject[];
}

const { title, description = business.defaultPageDescription, jsonLd } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/logo-small.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Syne:wght@400..800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <SEO description={description} jsonLd={jsonLd} />
    <ClientRouter />
  </head>
  <body class="bg-primary text-ink antialiased">
    <div class="noise-overlay"></div>
    <slot />
  </body>
</html>
