---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import LogoPlaceholder from '../../components/LogoPlaceholder.astro';
import { getCaseStudies, serviceLabels, serviceColors } from '../../lib/collections';
import { buildCaseStudyIndex, siteUrl } from '../../lib/jsonld';

const caseStudies = await getCaseStudies();

const caseStudyIndexDescription =
  "Explore how ENET Systems has helped brands across Kuwait and the MENA region transform their digital operations through e-commerce, ERP, and web development.";
const featured = caseStudies.filter((cs) => cs.data.featured);
const rest = caseStudies.filter((cs) => !cs.data.featured);
---

<Layout
  title="Case Studies | ENET Systems LTD"
  description={caseStudyIndexDescription}
  jsonLd={buildCaseStudyIndex({
    name: "Case Studies | ENET Systems LTD",
    description: caseStudyIndexDescription,
    url: siteUrl("/case-studies"),
  })}
>
  <Navbar />

  <!-- Page Header -->
  <section class="pt-16 pb-16 relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-accent/5 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 border border-accent/20 text-accent text-sm font-medium mb-6 opacity-0 animate-slide-up">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        {caseStudies.length} Case Studies
      </span>
      <h1 class="text-5xl md:text-6xl font-bold font-[family-name:var(--font-display)] mb-4 opacity-0 animate-slide-up animate-delay-100">
        Client Case Studies
      </h1>
      <p class="text-muted text-lg max-w-2xl mx-auto opacity-0 animate-slide-up animate-delay-200">
        Real stories of digital transformation. From single-service deployments to full-stack overhauls — see what we've built and the results it delivered.
      </p>
    </div>
  </section>

  <!-- Featured Case Studies -->
  {featured.length > 0 && (
    <section class="pb-12 bg-secondary/10">
      <div class="container-custom">
        <div class="flex items-center gap-3 mb-10 opacity-0 animate-slide-up">
          <div class="h-px flex-1 bg-border"></div>
          <span class="text-xs font-medium uppercase tracking-widest text-muted px-3">Featured</span>
          <div class="h-px flex-1 bg-border"></div>
        </div>

        <div class="grid md:grid-cols-2 gap-6 md:gap-8">
          {featured.map((cs, i) => {
            const study = cs.data;
            return (
              <a
                href={`/case-studies/${cs.id}`}
                class="featured-card group relative bg-secondary rounded-3xl overflow-hidden border border-border hover:border-accent/40 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:shadow-accent/5 opacity-0 animate-slide-up"
                style={`animation-delay: ${i * 100}ms`}
              >
                <div class="absolute inset-0 bg-gradient-to-br from-accent/3 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                <div class="relative p-8 md:p-10">
                  <!-- Top row: logo + service badges -->
                  <div class="flex items-start justify-between gap-4 mb-8">
                    <LogoPlaceholder name={study.name} size="lg" gradient={study.gradient as any} />
                    <div class="flex flex-wrap gap-2 justify-end">
                      {study.services.map((svc) => (
                        <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium border ${serviceColors[svc]}`}>
                          {serviceLabels[svc]}
                        </span>
                      ))}
                    </div>
                  </div>

                  <!-- Brand name + tagline -->
                  <h2 class="text-2xl md:text-3xl font-bold font-[family-name:var(--font-display)] mb-2 group-hover:text-accent transition-colors">
                    {study.name}
                  </h2>
                  {study.tagline && (
                    <p class="text-accent/70 text-sm font-medium mb-4">{study.tagline}</p>
                  )}
                  <p class="text-muted leading-relaxed">{study.desc}</p>

                  <!-- Read more -->
                  <div class="mt-8 flex items-center gap-2 text-sm font-semibold text-accent group-hover:gap-3 transition-all duration-300">
                    Read case study
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- All Case Studies Grid -->
  <section class="section-padding bg-secondary/20">
    <div class="container-custom">
      {featured.length > 0 && (
        <div class="flex items-center gap-3 mb-10 opacity-0 animate-slide-up">
          <div class="h-px flex-1 bg-border"></div>
          <span class="text-xs font-medium uppercase tracking-widest text-muted px-3">All Case Studies</span>
          <div class="h-px flex-1 bg-border"></div>
        </div>
      )}

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {rest.map((cs, i) => {
          const study = cs.data;
          return (
            <a
              href={`/case-studies/${cs.id}`}
              class="case-card group relative bg-secondary rounded-2xl overflow-hidden border border-border hover:border-accent/30 transition-all duration-400 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/20 opacity-0 animate-slide-up"
              style={`animation-delay: ${i * 60}ms`}
            >
              <div class="relative p-6">
                <!-- Logo + services row -->
                <div class="flex items-center justify-between gap-3 mb-5">
                  <LogoPlaceholder name={study.name} size="md" gradient={study.gradient as any} />
                  <div class="flex flex-wrap gap-1.5 justify-end">
                    {study.services.map((svc) => (
                      <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border ${serviceColors[svc]}`}>
                        {serviceLabels[svc]}
                      </span>
                    ))}
                  </div>
                </div>

                <h3 class="font-bold text-lg font-[family-name:var(--font-display)] mb-1.5 group-hover:text-accent transition-colors">
                  {study.name}
                </h3>
                <p class="text-muted text-sm leading-relaxed line-clamp-2">{study.desc}</p>

                <div class="mt-5 flex items-center gap-1.5 text-xs font-semibold text-muted group-hover:text-accent transition-colors group-hover:gap-2.5 duration-300">
                  Read case study
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-accent/8 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <h2 class="text-3xl md:text-4xl font-bold font-[family-name:var(--font-display)] mb-4 opacity-0 animate-slide-up">
        Want Results Like These?
      </h2>
      <p class="text-muted mb-8 max-w-xl mx-auto opacity-0 animate-slide-up animate-delay-100">
        Every case study started with a conversation. Let's talk about what we can build for your business.
      </p>
      <div class="flex flex-wrap justify-center gap-4 opacity-0 animate-slide-up animate-delay-200">
        <a href="/contact" class="btn-primary text-lg px-8 py-4">Start a Project</a>
        <a href="/services" class="btn-outline text-lg px-8 py-4">Our Services</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .featured-card {
    position: relative;
    overflow: hidden;
  }

  .case-card {
    position: relative;
    overflow: hidden;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
