---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getBlogPosts } from '../../lib/collections';
import { buildBlogIndex, siteUrl } from '../../lib/jsonld';

const posts = await getBlogPosts();

const blogIndexDescription =
  "Insights on Odoo ERP, e-commerce, web development, and digital transformation from the ENET Systems team.";

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<Layout
  title="Blog | ENET Systems LTD"
  description={blogIndexDescription}
  jsonLd={buildBlogIndex({
    name: "Blog | ENET Systems LTD",
    description: blogIndexDescription,
    url: siteUrl("/blog"),
  })}
>
  <Navbar />

  <section class="pt-16 pb-16 relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-accent/5 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom relative z-10 text-center">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 border border-accent/20 text-accent text-sm font-medium mb-6 opacity-0 animate-slide-up">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        {posts.length} Articles
      </span>
      <h1 class="text-5xl md:text-6xl font-bold font-[family-name:var(--font-display)] mb-4 opacity-0 animate-slide-up animate-delay-100">
        Blog
      </h1>
      <p class="text-muted text-lg max-w-2xl mx-auto opacity-0 animate-slide-up animate-delay-200">
        Practical notes on building software that runs businesses — ERP, commerce, and the web stack in between.
      </p>
    </div>
  </section>

  <section class="section-padding bg-secondary/20 border-t border-border">
    <div class="container-custom max-w-3xl">
      <ul class="flex flex-col gap-6">
        {
          posts.map((post, i) => {
            const { title, description, pubDate, author, tags } = post.data;
            return (
              <li
                class="opacity-0 animate-slide-up"
                style={`animation-delay: ${i * 80}ms`}
              >
                <article>
                  <a
                    href={`/blog/${post.id}`}
                    class="group block rounded-2xl border border-border bg-secondary p-6 md:p-8 transition-all duration-300 hover:border-accent/35 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-black/15"
                  >
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted mb-3">
                      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
                      {author && (
                        <>
                          <span class="text-border" aria-hidden="true">·</span>
                          <span>{author}</span>
                        </>
                      )}
                    </div>
                    <h2 class="text-xl md:text-2xl font-bold font-[family-name:var(--font-display)] mb-2 group-hover:text-accent transition-colors">
                      {title}
                    </h2>
                    <p class="text-muted leading-relaxed mb-4">{description}</p>
                    {tags && tags.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {tags.map((tag) => (
                          <span class="rounded-full border border-border bg-primary/40 px-2.5 py-0.5 text-xs font-medium text-muted">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </a>
                </article>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="container-custom text-center">
      <p class="text-muted text-sm">
        Want to work together?{' '}
        <a href="/contact" class="text-accent underline-offset-4 hover:underline">Get in touch</a>
        {' '}or explore{' '}
        <a href="/case-studies" class="text-accent underline-offset-4 hover:underline">case studies</a>.
      </p>
    </div>
  </section>

  <Footer />
</Layout>
