---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getBlogPosts } from '../../lib/collections';
import { buildBlogPosting, siteUrl } from '../../lib/jsonld';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { title, description, pubDate, updatedDate, author, tags } = entry.data;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const allPosts = await getBlogPosts();
const related = allPosts.filter((p) => p.id !== entry.id).slice(0, 3);

const postUrl = siteUrl(`/blog/${entry.id}`);
---

<Layout
  title={`${title} | Blog | ENET Systems`}
  description={description}
  jsonLd={buildBlogPosting({
    headline: title,
    description,
    url: postUrl,
    datePublished: pubDate,
    dateModified: updatedDate,
    author,
    keywords: tags,
  })}
>
  <Navbar />

  <article>
    <header class="pt-16 pb-12 relative overflow-hidden border-b border-border">
      <div class="absolute inset-0">
        <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-accent/5 rounded-full blur-3xl"></div>
      </div>

      <div class="container-custom relative z-10 max-w-3xl">
        <nav class="flex items-center gap-2 text-sm text-muted mb-10" aria-label="Breadcrumb">
          <a href="/blog" class="hover:text-white transition-colors flex items-center gap-1.5 group">
            <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Blog
          </a>
        </nav>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted mb-4">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {author && (
            <>
              <span class="text-border" aria-hidden="true">·</span>
              <span>{author}</span>
            </>
          )}
          {updatedDate && (
            <>
              <span class="text-border" aria-hidden="true">·</span>
              <span>Updated {formatDate(updatedDate)}</span>
            </>
          )}
        </div>

        <h1 class="text-4xl md:text-5xl font-bold font-[family-name:var(--font-display)] mb-4 leading-tight">
          {title}
        </h1>
        <p class="text-lg text-muted leading-relaxed">{description}</p>

        {tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-8">
            {tags.map((tag) => (
              <span class="rounded-full border border-accent/25 bg-accent/10 px-3 py-1 text-xs font-medium text-accent">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <section class="section-padding bg-secondary/20">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto prose-content">
          <Content />
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="pb-20 md:pb-28 border-t border-border">
        <div class="container-custom max-w-3xl">
          <div class="flex items-center gap-3 mb-8 pt-12">
            <div class="h-px flex-1 bg-border"></div>
            <span class="text-xs font-medium uppercase tracking-widest text-muted px-3">More posts</span>
            <div class="h-px flex-1 bg-border"></div>
          </div>
          <ul class="flex flex-col gap-4">
            {related.map((p) => (
              <li>
                <a
                  href={`/blog/${p.id}`}
                  class="group flex flex-col rounded-xl border border-border bg-secondary/60 px-5 py-4 transition-colors hover:border-accent/30"
                >
                  <span class="text-xs text-muted mb-1">
                    {p.data.pubDate.toLocaleDateString('en-GB', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </span>
                  <span class="font-semibold font-[family-name:var(--font-display)] group-hover:text-accent transition-colors">
                    {p.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </article>

  <Footer />
</Layout>

<style>
  .prose-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    font-family: var(--font-display);
    color: white;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
  }

  .prose-content :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    color: white;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .prose-content :global(p) {
    color: var(--color-muted, rgba(255, 255, 255, 0.6));
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }

  .prose-content :global(ul) {
    list-style: none;
    padding: 0;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .prose-content :global(ul li) {
    color: var(--color-muted, rgba(255, 255, 255, 0.6));
    padding-left: 1.5rem;
    position: relative;
    line-height: 1.7;
  }

  .prose-content :global(ul li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent, #28afa2);
  }

  .prose-content :global(ul li strong) {
    color: white;
    font-weight: 600;
  }

  .prose-content :global(a) {
    color: var(--color-accent, #28afa2);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.2s;
  }

  .prose-content :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .prose-content :global(code) {
    font-size: 0.875em;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
</style>
