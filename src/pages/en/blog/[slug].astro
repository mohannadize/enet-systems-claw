---
import { getCollection } from 'astro:content';
import { entryLocale, entrySlug } from '../../../lib/collections';
import BlogDetailPage from '../../../components/pages/BlogDetailPage.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('blog', ({ data }) => !data.draft)).filter((e) => entryLocale(e) === 'en');
  return entries.map((entry) => ({ params: { slug: entrySlug(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
---
<BlogDetailPage entry={entry} locale="en" />
